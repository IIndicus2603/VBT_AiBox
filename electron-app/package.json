{
  "name": "unv-smartbox-desktop",
  "version": "0.1.2",
  "description": "Vibotics AI Smart Box desktop application",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:win": "tsc && vite build && electron-builder --win",
    "build:backend": "cd .. && py -m PyInstaller -y --onedir --name aibox --console --add-binary go2rtc.exe;. --add-data go2rtc.yaml;. --add-data ui;ui aibox.py",
    "build:exe": "npm run build:backend && tsc && vite build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8"
  },
  "build": {
    "appId": "com.vibotics.unv-smartbox",
    "productName": "Vibotics AI Smart Box",
    "asar": true,
    "directories": {
      "output": "out4/${version}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      { "from": "../dist/aibox", "to": "aibox" }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
