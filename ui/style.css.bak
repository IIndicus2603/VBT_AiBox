:root{
  --bg:#0a0c0f; --panel:#0e1216; --tile:#101418; --field:#141a20; --raise:#182029; --card:#111721;
  --bd:#1d242b; --bd2:#222a32; --bd3:#262f38; --bd4:#33404c;
  --fg:#e6ebf0; --fg2:#c9d4de; --dim:#9fb0be; --muted:#7d8a97; --faint:#6b7a88; --ghost:#5c6a77; --off:#4a5764;
  --cy:#4dd0e1; --cy2:#7fe3ef; --ok:#3ddc84; --warn:#ffb020; --err:#ff4d4f; --err2:#ff7a7c; --vio:#b57cff;
  --m:'JetBrains Mono',ui-monospace,monospace; --b:Barlow,system-ui,sans-serif;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;height:100%;background:var(--bg);color:var(--fg);
  font-family:var(--b);-webkit-font-smoothing:antialiased}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-thumb{background:#2a323b;border-radius:4px}
::-webkit-scrollbar-track{background:transparent}
@keyframes omPulse{0%,100%{opacity:1}50%{opacity:.25}}
@keyframes omToastIn{from{transform:translateX(-24px);opacity:0}to{transform:translateX(0);opacity:1}}
@keyframes omScan{from{transform:translateY(-100%)}to{transform:translateY(1400%)}}
@keyframes omAlertBorder{0%,100%{border-color:rgba(255,77,79,.28);box-shadow:0 0 0 1px rgba(255,77,79,.12)}
  50%{border-color:var(--err);box-shadow:0 0 0 2px rgba(255,77,79,.5),0 0 30px rgba(255,77,79,.3)}}
[hidden]{display:none!important}

/* ---------- shell ---------- */
#app{height:100vh;min-height:600px;display:flex;flex-direction:column;overflow:hidden}
header{flex:none;display:flex;align-items:center;gap:18px;padding:0 18px;height:56px;
  background:var(--panel);border-bottom:1px solid var(--bd)}
.logo{width:26px;height:26px;border:1.5px solid var(--cy);border-radius:5px;display:grid;place-items:center;
  font:700 12px/1 var(--m);color:var(--cy);flex:none}
.brand{font:600 14px/1 var(--b);letter-spacing:.02em}
.brand-sub{font:400 9.5px/1 var(--m);color:var(--faint);letter-spacing:.12em}
.chip{display:flex;align-items:center;gap:8px;padding:5px 10px;background:var(--field);
  border:1px solid var(--bd2);border-radius:6px;white-space:nowrap;flex:none}
.k{font:400 10px/1 var(--m);color:var(--faint)}
.v{font:500 12.5px/1 var(--b)}
.dot{width:7px;height:7px;border-radius:50%;flex:none}
.stat{display:flex;align-items:center;gap:7px;font:500 11.5px/1 var(--m);color:var(--dim);white-space:nowrap}
#clock{font:500 13px/1 var(--m);color:var(--fg);border-left:1px solid var(--bd2);padding-left:20px}
.avatar{width:30px;height:30px;border-radius:50%;background:#1c2530;border:1px solid #2a3440;flex:none;
  display:grid;place-items:center;font:600 11px/1 var(--m);color:var(--dim)}
.body{flex:1;display:flex;min-height:0}
nav{flex:none;display:flex;align-items:center;gap:4px;padding:0 4px;
  border-left:1px solid var(--bd2);margin-left:4px}
nav>button{display:flex;align-items:center;gap:7px;padding:7px 11px;
  border:none;border-radius:6px;color:var(--faint);background:transparent}
nav>button:hover{background:#161d24;color:var(--fg2)}
nav>button.on{background:var(--raise);color:var(--cy)}
nav .i{font:500 14px/1 var(--m)}
nav .l{font:500 11.5px/1 var(--b);letter-spacing:.02em}
main{flex:1;display:flex;flex-direction:column;min-width:0;min-height:0}
.view{flex:1;display:flex;flex-direction:column;min-height:0}
.bar{flex:none;display:flex;align-items:center;gap:10px;padding:12px 18px;border-bottom:1px solid #161c22;
  flex-wrap:wrap}
.h1{font:600 15px/1 var(--b)}
.sub{font:400 11px/1 var(--m);color:var(--faint)}
.grow{flex:1}
.vr{width:1px;height:20px;background:var(--bd2);margin:0 4px;flex:none}
.scroll{flex:1;overflow:auto;padding:14px 18px 22px}
/* Live: lưới vừa khít khung, không scroll. Cột do JS đặt, hàng chia đều chiều cao. */
#v-live .scroll{overflow:hidden;display:flex;flex-direction:column;min-height:0;padding-bottom:14px}

/* ---------- controls ---------- */
button{font-family:var(--b);cursor:pointer}
.btn{display:flex;align-items:center;gap:7px;font:500 11.5px/1 var(--b);color:var(--fg2);
  background:var(--field);border:1px solid var(--bd2);border-radius:5px;padding:7px 11px;white-space:nowrap}
.btn:hover{border-color:var(--bd4);color:var(--fg)}
.btn.on{color:#08090b;background:var(--cy);border-color:var(--cy)}
.btn:disabled,.btn.dis{color:var(--off);cursor:default}
.btn:disabled:hover,.btn.dis:hover{border-color:var(--bd2);color:var(--off)}
.btn-cy{font:600 11.5px/1 var(--b);color:#08090b;background:var(--cy);border:none;border-radius:5px;
  padding:7px 12px;white-space:nowrap;display:flex;align-items:center;gap:7px}
.btn-cy:hover{background:var(--cy2)}
.btn-cy:disabled{background:#2b3b40;color:var(--muted);cursor:default}
.btn-gh{font:600 12px/1 var(--b);color:#8b9aa8;background:transparent;border:1px solid var(--bd3);
  border-radius:6px;padding:10px 16px;white-space:nowrap}
.btn-gh:hover{color:var(--fg)}
.seg{display:flex;background:var(--field);border:1px solid var(--bd2);border-radius:5px;overflow:hidden;flex:none}
.seg button{font:500 11px/1 var(--m);color:var(--dim);background:transparent;border:none;padding:7px 9px}
.seg button:hover{color:var(--fg)}
.seg button.on{color:#08090b;background:var(--cy)}
label{font:600 10.5px/1 var(--b);letter-spacing:.06em;color:var(--muted)}
input{font:500 12.5px/1.2 var(--b);color:var(--fg);background:var(--field);border:1px solid var(--bd3);
  border-radius:6px;padding:11px 12px;outline:none;width:100%;min-width:0}
input.mono{font:400 12.5px/1.2 var(--m)}
input:focus{border-color:var(--cy)}
.hint{font:400 10px/1.4 var(--m);color:var(--ghost)}
.field{display:flex;flex-direction:column;gap:6px}
/* --- card ket noi AI SmartBox: grid input 4 cot, hang nut can phai --- */
.cn-card{display:flex;flex-direction:column;gap:12px}
.cn-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1.5fr;gap:12px;align-items:start}
.cn-foot{display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  padding-top:12px;border-top:1px solid var(--bd)}
.cn-state{font:500 11px/1.3 var(--m);color:var(--dim);min-width:0}
@media (max-width:900px){.cn-grid{grid-template-columns:1fr 1fr}}
.drop{position:relative;flex:none}
.menu{position:absolute;top:calc(100% + 6px);right:0;z-index:70;min-width:190px;background:#12181e;
  border:1px solid var(--bd3);border-radius:7px;box-shadow:0 14px 34px rgba(0,0,0,.6);padding:5px}
#fList>button{display:flex;width:100%;align-items:center;gap:9px;padding:8px 10px;border-radius:5px;
  border:none;background:transparent}
#fList>button:hover{background:#1b232b}
.menu .l{flex:1;text-align:left;font:500 11.5px/1 var(--b);color:var(--dim);white-space:nowrap}
#fList>button.on{background:#1b232b}
#fList>button.on .l{color:var(--fg)}
.msep{height:1px;background:var(--bd3);margin:5px 2px}
.mrow{display:flex;align-items:center;gap:9px;padding:3px 8px 4px}

/* ---------- grid + tile ---------- */
/* Chiều cao chia đều theo khung, KHÔNG dùng aspect-ratio: tỉ lệ cố định làm
   chiều cao phụ thuộc độ rộng nên grid phình quá khung -> sinh scroll. */
#grid{display:grid;gap:12px;flex:1;min-height:0;grid-auto-rows:1fr}
.tile{position:relative;min-height:0;background:var(--tile);border:1px solid var(--bd2);
  border-radius:8px;overflow:hidden;cursor:pointer}
.tile:hover{border-color:var(--cy)}
.tile.alert{border-color:rgba(255,77,79,.55);
  box-shadow:0 0 0 1px rgba(255,77,79,.25),0 0 26px rgba(255,77,79,.12);
  animation:omAlertBorder 1.1s ease-in-out infinite}
video-stream{display:block;width:100%;height:100%}
video-stream video{display:block;width:100%;height:100%;object-fit:cover;background:#000}
.lines{position:absolute;inset:0;pointer-events:none;
  background:repeating-linear-gradient(0deg,rgba(255,255,255,.035) 0 1px,transparent 1px 3px)}
.scan{position:absolute;left:0;right:0;height:14%;pointer-events:none;
  background:linear-gradient(180deg,rgba(77,208,225,.12),transparent);animation:omScan 7s linear infinite}
.t-top{position:absolute;top:8px;left:9px;right:9px;display:flex;align-items:flex-start;gap:8px;
  pointer-events:none}
.t-id{flex:1;min-width:0}
.t-name{font:600 14.5px/1.2 var(--b);color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.9);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.t-code{font:400 11px/1.3 var(--m);color:rgba(255,255,255,.62);text-shadow:0 1px 3px rgba(0,0,0,.9);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.badge{flex:none;font:700 10px/1 var(--m);letter-spacing:.1em;padding:4px 6px;border-radius:3px;
  color:var(--ok);background:rgba(10,12,15,.7);border:1px solid rgba(61,220,132,.4);white-space:nowrap}
.badge.off{color:var(--err2);background:rgba(255,77,79,.16);border-color:rgba(255,77,79,.45)}
.badge.wait{color:var(--warn);background:rgba(255,176,32,.14);border-color:rgba(255,176,32,.4)}
.t-bot{position:absolute;bottom:0;left:0;right:0;padding:16px 9px 8px;display:flex;align-items:center;gap:8px;
  background:linear-gradient(180deg,transparent,rgba(6,8,10,.88));pointer-events:none}
.t-meta{font:400 11.5px/1 var(--m);color:rgba(255,255,255,.72);white-space:nowrap}
.t-note{font:500 11.5px/1 var(--m);color:var(--ghost);white-space:nowrap;overflow:hidden;
  text-overflow:ellipsis;text-align:right}
/* nút xoá chỉ nằm trong màn chi tiết, không còn trên tile */
.btn-del{color:var(--err2);border-color:rgba(255,77,79,.32)}
.btn-del:hover{color:#fff;background:rgba(255,77,79,.5);border-color:var(--err)}
.pager{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:10px;padding:16px 2px 0}
.pager .mid{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:10px}
.pg{min-width:32px;font:600 11.5px/1 var(--m);color:#8b9aa8;background:var(--field);
  border:1px solid var(--bd2);border-radius:5px;padding:7px 8px}
.pg.on{color:#08090b;background:var(--cy);border-color:var(--cy)}
.range{justify-self:end;font:400 10.5px/1 var(--m);color:var(--faint);white-space:nowrap}
.empty{grid-column:1/-1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;
  min-height:240px;background:#0c1014;border:1px dashed #2a333c;border-radius:9px;color:var(--fg2)}
.empty .plus{font:400 26px/1 var(--m);color:var(--cy)}
.empty .t{font:600 12px/1.3 var(--b)}

/* ---------- detail ---------- */
.split{flex:1;display:flex;min-height:0}
.stage-wrap{flex:1;display:flex;flex-direction:column;min-width:0;min-height:0;overflow:hidden;
  padding:14px 0 14px 18px}
.stage{position:relative;flex:1;min-height:0;background:#0d1115;border:1px solid var(--bd2);
  border-radius:9px;overflow:hidden}
.stage video-stream{position:absolute;inset:0}
.stage video-stream video{object-fit:contain}
.s-top{position:absolute;top:12px;left:14px;display:flex;align-items:center;gap:9px}
.live{display:flex;align-items:center;gap:6px;font:700 9.5px/1 var(--m);letter-spacing:.12em;color:var(--err);
  background:rgba(10,12,15,.75);border:1px solid rgba(255,77,79,.4);padding:5px 8px;border-radius:3px}
.live .dot{background:var(--err);width:6px;height:6px;animation:omPulse 1.4s infinite}
.qual{font:500 10px/1 var(--m);color:rgba(255,255,255,.75);background:rgba(10,12,15,.7);
  padding:6px 8px;border-radius:3px;white-space:nowrap}
.s-bot{position:absolute;bottom:0;left:0;right:0;padding:26px 14px 12px;display:flex;align-items:center;gap:14px;
  background:linear-gradient(180deg,transparent,rgba(6,8,10,.9))}
.s-bot button{font:500 17px/1 var(--m);color:rgba(255,255,255,.85);background:transparent;border:none;padding:0}
.s-bot button:hover{color:var(--cy)}
aside{flex:none;width:272px;padding:14px 18px 14px 12px;display:flex;flex-direction:column;gap:10px;
  overflow:auto}
.card{background:var(--panel);border:1px solid var(--bd);border-radius:9px;padding:12px 13px}
.card-h{font:600 11px/1 var(--b);letter-spacing:.06em;color:var(--muted);margin-bottom:10px}
.row{display:flex;align-items:baseline;gap:10px;padding:5px 0;border-bottom:1px solid #151b21}
.row:last-child{border-bottom:none}
.row .rk{flex:none;width:76px;font:400 10px/1.3 var(--m);color:var(--faint)}
.row .rv{flex:1;font:500 11px/1.35 var(--m);color:var(--fg2);word-break:break-all}
.rv.ok{color:var(--ok)}.rv.warn{color:var(--warn)}.rv.err{color:var(--err2)}.rv.dim{color:var(--dim)}
.rv.none{color:var(--ghost)}

/* ---------- log / config ---------- */
.log{display:flex;flex-direction:column;gap:5px}
.log-row{display:flex;align-items:baseline;gap:10px;background:var(--card);border:1px solid #1e262e;
  border-left:3px solid var(--faint);border-radius:6px;padding:8px 11px}
.log-row.err{border-left-color:var(--err)}
.log-row.warn{border-left-color:var(--warn)}
.log-row.info{border-left-color:var(--ok)}
.log-t{flex:none;font:400 10.5px/1.4 var(--m);color:var(--faint)}
.log-lv{flex:none;width:44px;font:700 9.5px/1.4 var(--m);letter-spacing:.08em;color:var(--muted)}
.log-row.err .log-lv{color:var(--err2)}
.log-row.warn .log-lv{color:var(--warn)}
.log-row.info .log-lv{color:var(--ok)}
.log-m{flex:1;font:400 11px/1.45 var(--m);color:var(--fg2);word-break:break-word}
.log-c{flex:none;font:400 10px/1.4 var(--m);color:var(--ghost);white-space:nowrap}
pre.yaml{margin:0;font:400 11.5px/1.6 var(--m);color:var(--fg2);white-space:pre-wrap;word-break:break-word}

/* ---------- modal ---------- */
.overlay{position:fixed;inset:0;z-index:90;background:rgba(5,7,9,.72);backdrop-filter:blur(3px);
  display:flex;align-items:center;justify-content:center;padding:24px}
.modal{width:100%;max-width:820px;max-height:100%;overflow:auto;background:var(--panel);
  border:1px solid #232c34;border-radius:12px;box-shadow:0 30px 80px rgba(0,0,0,.7)}
.m-head{display:flex;align-items:center;gap:12px;padding:16px 20px;border-bottom:1px solid #1b222a}
.m-title{font:600 17px/1.2 var(--b)}
.m-x{font:500 17px/1 var(--m);color:var(--ghost);background:transparent;border:none;padding:0}
.m-x:hover{color:var(--fg)}
.m-body{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;padding:18px 20px 20px}
.m-col{display:flex;flex-direction:column;gap:14px}
.m-foot{position:sticky;bottom:0;display:flex;align-items:center;gap:10px;padding:14px 20px;
  border-top:1px solid #1b222a;background:var(--panel)}
.preview{position:relative;aspect-ratio:16/9;background:linear-gradient(160deg,#12171c,#0c1013);
  border:1px solid var(--bd3);border-radius:8px;overflow:hidden;display:grid;place-items:center}
.preview .msg{font:500 11.5px/1.4 var(--m);color:var(--muted);background:rgba(8,10,13,.7);
  border:1px solid var(--bd3);padding:8px 12px;border-radius:4px;text-align:center;max-width:90%}
.preview .msg.ok{color:var(--ok);border-color:rgba(61,220,132,.45)}
.preview .msg.warn{color:var(--warn);border-color:rgba(255,176,32,.45)}
.preview .msg.err{color:var(--err2);border-color:rgba(255,77,79,.45)}
.test-card{background:var(--card);border:1px solid #1e262e;border-radius:8px;padding:12px 13px}

/* ---------- toasts ---------- */
#toasts{position:fixed;left:14px;bottom:18px;z-index:60;width:376px;pointer-events:none}
.toast{position:absolute;left:0;right:0;bottom:0;transform-origin:bottom center;display:flex;
  flex-direction:column;background:#12181e;border:1px solid #242d36;border-top:3px solid var(--warn);
  border-radius:9px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,.68);
  animation:omToastIn .28s ease-out;transition:transform .22s ease,opacity .22s ease;pointer-events:auto}
.toast.err{border-color:rgba(255,77,79,.4);border-top-color:var(--err)}
.toast.ok{border-top-color:var(--ok)}
.t-head{display:flex;align-items:center;gap:9px;padding:9px 12px 8px}
.t-head .dot{background:var(--warn);width:8px;height:8px;animation:omPulse 1.4s infinite}
.toast.err .t-head .dot{background:var(--err)}
.toast.ok .t-head .dot{background:var(--ok)}
.t-sev{font:700 10px/1 var(--m);letter-spacing:.1em;color:var(--warn)}
.toast.err .t-sev{color:var(--err)}
.toast.ok .t-sev{color:var(--ok)}
.t-older{font:500 10px/1 var(--m);color:#8b9aa8;background:#1b232b;border:1px solid var(--bd3);
  padding:4px 7px;border-radius:99px;white-space:nowrap}
.t-time{font:400 11px/1 var(--m);color:var(--faint)}
.t-close{font:500 14px/1 var(--m);color:var(--ghost);background:transparent;border:none;padding:0 0 0 4px}
.t-close:hover{color:var(--fg)}
.t-body{padding:2px 13px 13px;display:flex;flex-direction:column;gap:5px}
.t-title{font:600 16.5px/1.25 var(--b);color:var(--fg)}
.t-sub{font:400 11.5px/1.35 var(--m);color:#8b9aa8;word-break:break-word}
.t-acts{display:flex;gap:8px;margin-top:7px}
.t-acts .go{flex:1;font:600 12.5px/1 var(--b);color:#08090b;background:var(--warn);border:none;
  border-radius:5px;padding:10px 14px}
.toast.err .t-acts .go{background:var(--err)}
.toast.ok .t-acts .go{background:var(--ok)}
.t-acts .skip{flex:none;font:600 12.5px/1 var(--b);color:#8b9aa8;background:transparent;
  border:1px solid var(--bd3);border-radius:5px;padding:10px 14px}
.t-acts .skip:hover{color:var(--fg)}

/* ---------- AI config panel ---------- */
.ai-modal{width:min(1180px,94vw);max-height:92vh}
.ai-mbody{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(320px,.85fr);gap:16px;
  align-items:start;overflow:auto}
.ai-left{display:flex;flex-direction:column;gap:9px;min-width:0}
.ai-shot{position:relative;background:#000;border:1px solid var(--bd2);border-radius:8px;
  overflow:hidden;aspect-ratio:16/9}
.ai-shot img{display:block;width:100%;height:100%;object-fit:contain}
.ai-shot canvas{position:absolute;inset:0;width:100%;height:100%;cursor:crosshair}
.ai-tools{display:flex;align-items:center;gap:10px}
.ai-right{display:flex;flex-direction:column;gap:12px;min-width:0}
.ai-load{padding:26px 4px;color:var(--muted);font:400 12.5px/1.5 var(--b);text-align:center}
.ai-list{display:flex;flex-direction:column;gap:2px;max-height:min(46vh,420px);overflow:auto;
  background:var(--card);border:1px solid var(--bd);border-radius:8px;padding:6px}
.ai-row{display:flex;align-items:center;gap:9px;padding:8px 9px;border-radius:6px;cursor:pointer;
  border:1px solid transparent}
.ai-row:hover{background:var(--raise)}
.ai-row.on{background:var(--raise);border-color:var(--cy);box-shadow:inset 2px 0 0 var(--cy)}
.ai-row input{width:auto;margin:0;accent-color:var(--cy);cursor:pointer;flex:none}
.ai-nm{flex:1;font:500 12.5px/1.3 var(--b);min-width:0;overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap}
.ai-tag{font:400 9.5px/1 var(--m);color:var(--faint);border:1px solid var(--bd3);border-radius:4px;
  padding:3px 5px;flex:none;letter-spacing:.04em}
.ai-pt{font:400 10px/1 var(--m);color:var(--ghost);flex:none;min-width:74px;text-align:right}
.ai-tune{background:var(--card);border:1px solid var(--bd);border-radius:8px;padding:11px 12px 13px;
  display:flex;flex-direction:column;gap:11px}
.ai-sl{display:grid;grid-template-columns:1fr 116px 42px;align-items:center;gap:10px}
.ai-sl label{font:400 11.5px/1.3 var(--b);color:var(--dim)}
.ai-sl input[type=range]{width:100%;padding:0;accent-color:var(--cy);cursor:pointer;background:none;
  border:none}
.ai-sl input:disabled{opacity:.35;cursor:not-allowed}
.ai-v{font:500 11.5px/1 var(--m);color:var(--fg2);text-align:right}
/* badge AI trên tile ở lưới Live */
.t-ai{font:500 9px/1 var(--m);color:var(--vio);border:1px solid rgba(181,124,255,.4);
  border-radius:4px;padding:3px 5px;letter-spacing:.06em;flex:none}
.al-row{display:flex;align-items:center;gap:9px;padding:6px 8px;border-bottom:1px solid var(--bd);
  font:400 11.5px/1.4 var(--m)}
.al-row .t{color:var(--faint);flex:none}
.al-row .m{color:var(--vio);flex:none}
.al-row .c{color:var(--fg2);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.al-row img{height:34px;border-radius:3px;border:1px solid var(--bd3);flex:none}

/* ---------- alarm: ảnh trong popup ---------- */
.t-img{display:block;width:100%;max-height:172px;object-fit:cover;border-radius:6px;
  border:1px solid var(--bd3);margin:9px 0 2px;cursor:pointer;background:#000}
.t-img:hover{border-color:var(--err)}
.toast.alarm{border-color:rgba(255,77,79,.45);border-top-color:var(--err)}
.toast.alarm .t-head .dot{background:var(--err);animation:omPulse 1.2s ease-in-out infinite}
.toast.alarm .t-sev{color:var(--err)}
.toast.alarm .t-acts .go{background:var(--err)}

/* ---------- tile đang cảnh báo: viền nháy đỏ ---------- */
/* Tách khỏi .tile.alert (mất kết nối) — hai loại cảnh báo khác nhau, đỏ nháy
   mạnh hơn dành cho AI detect vì cần người xem phản ứng. */
.tile.detect{border-color:var(--err);
  animation:omDetect 1s ease-in-out infinite}
@keyframes omDetect{
  0%,100%{box-shadow:0 0 0 1px rgba(255,77,79,.35),0 0 18px rgba(255,77,79,.18)}
  50%{box-shadow:0 0 0 2px var(--err),0 0 34px rgba(255,77,79,.5)}}
.t-ai{font:600 9.5px/1 var(--m);color:#0a0c0f;background:var(--err);border-radius:4px;
  padding:4px 6px;letter-spacing:.04em;flex:none;cursor:pointer;user-select:none}
.t-ai:hover{background:var(--err2)}

/* ---------- thanh lịch sử cảnh báo (trang chi tiết) ---------- */
.hist-bar{flex:none;margin-top:10px;background:var(--card);border:1px solid var(--bd);
  border-radius:8px;padding:9px 11px 11px;display:flex;flex-direction:column;gap:8px}
.hist-h{display:flex;align-items:center;gap:10px}
.hist-t{font:500 10px/1 var(--m);color:var(--faint);letter-spacing:.12em}
.hist-n{font:500 11px/1 var(--m);color:var(--dim)}
.hist-list{display:flex;gap:8px;overflow-x:auto;padding-bottom:3px;min-height:66px}
.h-item{flex:none;width:104px;display:flex;flex-direction:column;gap:3px;cursor:default}
.h-item img,.h-noimg{width:104px;height:59px;border-radius:5px;border:1px solid var(--bd3);
  object-fit:cover;background:#000;display:block}
.h-noimg{display:grid;place-items:center;font:400 9px/1 var(--m);color:var(--ghost)}
.h-algo{font:500 10px/1.25 var(--b);color:var(--fg2);overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap}
.h-time{font:400 9.5px/1 var(--m);color:var(--faint)}
.h-empty{font:400 11.5px/1.4 var(--b);color:var(--muted);padding:22px 2px;align-self:center}

/* ---------- tab Cấu hình: 20 thuật toán box nạp ---------- */
.al-head{display:flex;align-items:center;gap:10px;padding:2px 0 9px}
.al-cnt{font:600 13px/1 var(--m);color:var(--cy)}
/* Bang 2 cot: trai = Category, phai = Algorithm Function. Dung grid 2 cot chu khong
   phai <table> vi o phai la mot luoi con (nhieu the thuat toan tu wrap). */
.al-grid{display:grid;grid-template-columns:minmax(150px,210px) 1fr;
  max-height:min(56vh,520px);overflow:auto;border:1px solid var(--bd);border-radius:7px}
.al-th{position:sticky;top:0;z-index:2;display:flex;align-items:center;gap:8px;
  padding:9px 12px;background:var(--raise);border-bottom:1px solid var(--bd2);
  font:600 10.5px/1 var(--b);letter-spacing:.07em;color:var(--dim);text-transform:uppercase}
.al-items{display:grid;grid-template-columns:repeat(auto-fill,minmax(196px,1fr));gap:5px;
  padding:8px 10px;border-bottom:1px solid var(--bd);min-width:0}
.al-items:last-child{border-bottom:none}
.al-item{display:flex;align-items:center;gap:8px;padding:7px 9px;border-radius:6px;
  border:1px solid var(--bd);background:var(--tile);min-width:0}
.al-item.on{border-color:var(--cy);background:rgba(77,208,225,.07)}
.al-dot{width:7px;height:7px;border-radius:50%;background:var(--off);flex:none}
.al-item.on .al-dot{background:var(--cy)}
.al-nm{font:400 12px/1.3 var(--b);color:var(--muted);overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap}
.al-item.on .al-nm{color:var(--fg);font-weight:500}
.al-foot{display:flex;align-items:center;gap:10px;padding-top:11px}
/* Tieu de nhom trong .al-grid: grid auto-fill nen phai chiem ca dong, khong thi
   no tinh nhu mot o va cac thuat toan tran len cung hang. */
/* O cot trai: ten nhom + so dang nap. Khong dat grid-column nua — day la mot O
   trong bang 2 cot, khong con la header tran ca dong. */
.al-cat{display:flex;flex-direction:column;gap:4px;justify-content:center;
  padding:10px 12px;background:#0c1015;border-right:1px solid var(--bd);
  border-bottom:1px solid var(--bd);min-width:0}
.al-cat:nth-last-child(2){border-bottom:none}
.al-cat .c{font:600 11.5px/1.3 var(--b);color:var(--fg2)}
.al-cat .n{font:500 10px/1 var(--m);color:var(--faint)}
.al-load{padding:26px 4px;color:var(--muted);font:400 12.5px/1.5 var(--b);text-align:center;
  grid-column:1/-1}
.al-grid:has(.al-load){grid-template-columns:1fr}

/* ---------- tab Camera: danh sách ---------- */
.cam-list{display:flex;flex-direction:column;gap:6px}
.cam-row{display:flex;align-items:center;gap:13px;padding:11px 13px;background:var(--card);
  border:1px solid var(--bd);border-radius:8px}
.cam-row.off{opacity:.55}
.cam-row:hover{border-color:var(--bd4)}
.cam-id{font:600 12px/1 var(--m);color:var(--cy);min-width:38px;flex:none}
.cam-mid{display:flex;flex-direction:column;gap:2px;min-width:110px;flex:none}
.cam-nm{font:500 13.5px/1.2 var(--b);color:var(--fg)}
.cam-ip{font:400 10.5px/1 var(--m);color:var(--faint)}
.cam-tags{display:flex;flex-wrap:wrap;gap:5px;flex:1;min-width:0}
.cam-tag{font:400 10.5px/1 var(--m);color:var(--vio);border:1px solid rgba(181,124,255,.34);
  border-radius:4px;padding:4px 6px;white-space:nowrap}
.cam-none{font:400 11px/1 var(--m);color:var(--ghost)}
.cam-st{font:600 9.5px/1 var(--m);letter-spacing:.08em;flex:none;min-width:56px;text-align:right}
.cam-st.ok{color:var(--ok)}
.cam-st.off{color:var(--err2)}
.cam-cfg{flex:none}
