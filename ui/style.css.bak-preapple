/* Token lay 1:1 tu "Camera Monitoring.dc.html". Doi mau o day, khong rai trong JS. */
:root{
  --bg:#070a10; --head:#0c1119; --card:#101418; --card2:#12181e; --field:#131a24;
  --bd:#1d242b; --bd2:#161c22; --bd3:#262f38; --bd4:#222a32; --hov:#182029;
  --fg:#e6ebf0; --fg2:#c3ccd4; --dim:#8b9aa8; --ghost:#6b7a88;
  --gold:#d9a233; --gold2:#eab748; --gold3:#c48a29;
  --grad:linear-gradient(165deg,#e5bc63 0%,#d9a233 30%,#c48a29 58%,#a8722a 78%,#d19c33 100%);
  --gradh:linear-gradient(165deg,#f0cd82 0%,#eab748 30%,#d69c34 58%,#bb833a 78%,#e5b74e 100%);
  --teal:#5fe3d0; --ok:#3ddc97; --warn:#e8a020; --err:#ff4d4f; --err2:#ff7a7c;
  --b:Barlow,system-ui,sans-serif; --m:'JetBrains Mono',monospace;
  --sa:'Saira Condensed',var(--b);
}
html,body{margin:0;padding:0;background:var(--bg);color:var(--fg);font-family:var(--b);
  -webkit-font-smoothing:antialiased}
*{box-sizing:border-box}
a{color:var(--gold);text-decoration:none}
a:hover{color:var(--gold2)}
button,input,select{font-family:inherit}
[hidden]{display:none!important}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-thumb{background:#2a323b;border-radius:4px}
::-webkit-scrollbar-track{background:transparent}
.nosb{scrollbar-width:none;-ms-overflow-style:none}
.nosb::-webkit-scrollbar{display:none;width:0;height:0}
.grow{flex:1}
.vr{width:1px;height:20px;background:var(--bd4);margin:0 4px;flex:none}

/* ---------- animation cua design ---------- */
@keyframes omPulse{0%,100%{opacity:1}50%{opacity:.25}}
@keyframes omToastIn{from{transform:translateX(-24px);opacity:0}to{transform:translateX(0);opacity:1}}
@keyframes omScan{from{transform:translateY(-100%)}to{transform:translateY(1400%)}}
@keyframes omSheen{from{transform:translateX(-130%) skewX(-14deg)}to{transform:translateX(260%) skewX(-14deg)}}
@keyframes omShake{0%,100%{transform:translateX(0)}25%{transform:translateX(-3px)}75%{transform:translateX(3px)}}
@keyframes omViewIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@keyframes omAlertBorder{
  0%,100%{border-color:rgba(255,77,79,.28);box-shadow:0 0 0 1px rgba(255,77,79,.12)}
  50%{border-color:var(--err);box-shadow:0 0 0 2px rgba(255,77,79,.5),0 0 30px rgba(255,77,79,.3)}}
@keyframes omSpin{to{transform:rotate(360deg)}}

/* vet sang chay quanh vien khi hover: 4 canh, moi canh tre 0.9s -> chay vong */
@keyframes omEdgeTop{
  0%{left:-48%;opacity:1} 25%{left:52%;opacity:1} 42%{left:100%;opacity:1}
  42.01%{left:100%;opacity:0} 100%{left:100%;opacity:0}}
@keyframes omEdgeRight{
  0%{top:-48%;opacity:1} 25%{top:52%;opacity:1} 42%{top:100%;opacity:1}
  42.01%{top:100%;opacity:0} 100%{top:100%;opacity:0}}
@keyframes omEdgeBottom{
  0%{left:100%;opacity:1} 25%{left:0%;opacity:1} 42%{left:-48%;opacity:1}
  42.01%{left:-48%;opacity:0} 100%{left:-48%;opacity:0}}
@keyframes omEdgeLeft{
  0%{top:100%;opacity:1} 25%{top:0%;opacity:1} 42%{top:-48%;opacity:1}
  42.01%{top:-48%;opacity:0} 100%{top:-48%;opacity:0}}

[data-edge]{position:absolute;opacity:0;z-index:5;pointer-events:none;
  box-shadow:0 0 10px rgba(255,227,163,.55)}
[data-edge="top"]{left:-48%;top:0;width:48%;height:2px;
  background:linear-gradient(90deg,transparent,#ffe3a3,transparent)}
[data-edge="right"]{left:calc(100% - 2px);top:-48%;width:2px;height:48%;
  background:linear-gradient(180deg,transparent,#ffe3a3,transparent)}
[data-edge="bottom"]{left:100%;top:calc(100% - 2px);width:48%;height:2px;
  background:linear-gradient(270deg,transparent,#ffe3a3,transparent)}
[data-edge="left"]{left:0;top:100%;width:2px;height:48%;
  background:linear-gradient(0deg,transparent,#ffe3a3,transparent)}
[data-rim]:hover [data-edge="top"]{animation:omEdgeTop 3.6s linear infinite}
[data-rim]:hover [data-edge="right"]{animation:omEdgeRight 3.6s linear .9s infinite}
[data-rim]:hover [data-edge="bottom"]{animation:omEdgeBottom 3.6s linear 1.8s infinite}
[data-rim]:hover [data-edge="left"]{animation:omEdgeLeft 3.6s linear 2.7s infinite}
[data-rim]:hover{border-color:var(--gold3)!important;
  box-shadow:0 0 0 1px rgba(196,138,41,.35),0 10px 26px rgba(0,0,0,.45)}

/* sheen: vet sang chay qua nut vang khi hover */
[data-sheen]{position:relative;overflow:hidden}
[data-sheen]::before{content:'';position:absolute;top:0;bottom:0;left:0;width:38%;
  background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent);
  transform:translateX(-130%) skewX(-14deg);pointer-events:none;opacity:0}
[data-sheen]:hover::before{opacity:1;animation:omSheen .5s ease-out}

/* ---------- shell ---------- */
#app{height:100vh;min-height:600px;display:flex;flex-direction:column;overflow:hidden}
header{flex:none;display:flex;align-items:center;gap:18px;padding:0 18px;height:70px;
  background:var(--head);border-bottom:1px solid var(--bd)}
.logo{width:54px;height:54px;flex:none;
  background:url(assets/logo-app.png) center/contain no-repeat}
.brand{font:900 26px/1 var(--sa);letter-spacing:.04em;text-transform:uppercase;color:#fff;
  white-space:nowrap}
.brand-sub{font:700 13px/1 var(--sa);color:var(--gold);letter-spacing:.14em;
  text-transform:uppercase;white-space:nowrap}
.chip{display:flex;align-items:center;gap:7px;background:var(--field);border:1px solid var(--bd3);
  border-radius:5px;padding:6px 10px;flex:none}
.chip .k{font:400 9.5px/1 var(--m);color:var(--ghost);letter-spacing:.08em}
.chip .v{font:600 11.5px/1 var(--b);color:var(--gold)}
/* Neo giua thanh theo CHIEU RONG HEADER, khong theo cac phan tu ben canh:
   dat trong luong flex thi nav xe dich moi khi ten camera / trang thai box doi do dai. */
nav{position:absolute;left:50%;transform:translateX(-50%);
  display:flex;align-items:center;gap:4px;flex:none}
nav button{position:relative;width:38px;height:38px;display:grid;place-items:center;
  background:transparent;border:none;border-radius:7px;cursor:pointer;padding:0}
nav button:hover{background:var(--hov)}
nav button.on{background:var(--hov)}
nav button svg{width:20px;height:20px;stroke:var(--ghost);fill:none;stroke-width:1.6;
  stroke-linecap:round;stroke-linejoin:round}
nav button.on svg{stroke:var(--gold)}
nav .badge{position:absolute;top:3px;right:3px;min-width:15px;height:15px;padding:0 3px;
  border-radius:8px;background:var(--err);color:#fff;font:600 9px/15px var(--m);text-align:center}
.stat{display:flex;align-items:center;gap:7px;font:500 11px/1 var(--b);color:var(--dim);flex:none}
.stat .dot{width:7px;height:7px;border-radius:50%;background:var(--ghost);flex:none}
#clock{font:500 12.5px/1 var(--m);color:var(--fg2);flex:none}
.avatar{width:31px;height:31px;border-radius:50%;background:var(--field);border:1px solid var(--bd3);
  display:grid;place-items:center;font:600 11px/1 var(--b);color:var(--gold);flex:none}
.body{flex:1;display:flex;min-height:0}
main{flex:1;display:flex;flex-direction:column;min-width:0;min-height:0}
.view{flex:1;display:flex;flex-direction:column;min-height:0}

/* ---------- bar / scroll ---------- */
.bar{flex:none;display:flex;align-items:center;gap:10px;padding:12px 18px;
  border-bottom:1px solid var(--bd2)}
.h1{font:600 15px/1 var(--b)}
.sub{font:400 11px/1 var(--m);color:var(--gold)}
.sub.q{color:var(--ghost)}
.scroll{flex:1;overflow:auto;padding:14px 18px 22px;
  animation:omViewIn .3s cubic-bezier(.2,.8,.2,1) both}

/* ---------- nut ---------- */
.btn{display:flex;align-items:center;gap:7px;font:500 11.5px/1 var(--b);color:var(--dim);
  background:var(--field);border:1px solid var(--bd3);border-radius:5px;padding:7px 11px;
  cursor:pointer;white-space:nowrap}
.btn:hover{border-color:var(--gold3);color:var(--gold2)}
.btn.on{color:var(--gold);border-color:var(--gold3)}
.btn-cy{display:flex;align-items:center;gap:7px;font:600 11.5px/1 var(--b);color:#08090b;
  background:var(--grad);border:none;border-radius:5px;padding:7px 12px;cursor:pointer;
  white-space:nowrap;box-shadow:inset 0 1px 0 rgba(255,255,255,.24),
  inset 0 -1px 0 rgba(0,0,0,.2),0 1px 3px rgba(0,0,0,.5)}
.btn-cy:hover{background:var(--gradh)}
.btn-cy:disabled,.btn:disabled{opacity:.5;cursor:progress}
.hint code{font:400 10px/1 var(--m);color:var(--fg2)}
.btn-gh{background:transparent;border:1px solid var(--bd3);color:var(--dim);border-radius:5px;
  padding:7px 12px;font:500 11.5px/1 var(--b);cursor:pointer}
.btn-gh:hover{color:var(--fg2)}
.btn-del:hover{border-color:var(--err);color:var(--err2)}
.ico{width:28px;height:28px;display:grid;place-items:center;border-radius:5px;cursor:pointer;
  flex:none}
.ico:hover{background:var(--hov)}
.ico.rm:hover{background:#241a1c}
.ico svg{width:16px;height:16px;fill:none;stroke:var(--dim);stroke-width:1.7;
  stroke-linecap:round;stroke-linejoin:round}
.ico.gold svg{stroke:var(--gold)}
.seg{display:flex;background:var(--field);border:1px solid var(--bd3);border-radius:5px;
  overflow:hidden;flex:none}
.seg button{background:transparent;border:none;color:var(--ghost);font:500 11px/1 var(--b);
  padding:7px 11px;cursor:pointer}
.seg button.on{background:var(--hov);color:var(--gold)}

/* ---------- drop menu (loc) ---------- */
.drop{position:relative;flex:none}
.menu{position:absolute;top:calc(100% + 6px);right:0;z-index:70;min-width:180px;
  background:var(--card2);border:1px solid var(--bd3);border-radius:7px;
  box-shadow:0 14px 34px rgba(0,0,0,.6);padding:5px}
.menu .mrow{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:5px;
  cursor:pointer}
.menu .mrow:hover{background:var(--hov)}
.menu .mrow.on{background:var(--hov)}
.menu .mrow .dot{width:6px;height:6px;border-radius:50%;flex:none}
.menu .mrow .l{flex:1;font:500 11.5px/1 var(--b);color:var(--dim);white-space:nowrap}
.menu .mrow.on .l{color:var(--gold)}
.menu .mrow .k{font:400 10px/1 var(--m);color:var(--ghost)}
.msep{height:1px;background:var(--bd4);margin:5px 0}

/* ---------- LIVE grid ---------- */
#grid{display:grid;gap:12px}
.tile{position:relative;aspect-ratio:16/9;overflow:hidden;background:#101418;
  border:1px solid var(--bd);border-radius:8px;cursor:pointer;transition:border-color .18s ease}
/* overflow:hidden GIU nguyen nhu design: vet sang chay SAT TRONG vien, khong tran ra. */
.tile.alert{animation:omAlertBorder 1.1s ease-in-out infinite}
.tile.detect{animation:omAlertBorder .9s ease-in-out infinite}
.tile video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
  border-radius:8px;background:#0a0d12}
.tile video-stream{position:absolute;inset:0;border-radius:8px;overflow:hidden}
.lines{position:absolute;inset:0;border-radius:8px;pointer-events:none;
  background:repeating-linear-gradient(0deg,rgba(255,255,255,.035) 0 1px,transparent 1px 3px)}
.scan{position:absolute;left:0;right:0;height:14%;pointer-events:none;
  background:linear-gradient(180deg,rgba(232,160,32,.12),transparent);
  animation:omScan 7s linear infinite}
.t-top{position:absolute;top:9px;left:10px;right:10px;display:flex;align-items:flex-start;gap:8px}
.t-id{flex:1;min-width:0}
.t-name{font:600 12px/1.25 var(--b);color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.8);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.t-code{font:400 9.5px/1.3 var(--m);color:#b9c4cd;text-shadow:0 1px 3px rgba(0,0,0,.8);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.badge{flex:none;font:600 9px/1 var(--m);letter-spacing:.06em;padding:4px 6px;border-radius:3px;
  background:rgba(61,220,151,.16);color:var(--ok);border:1px solid rgba(61,220,151,.3)}
.badge.wait{background:rgba(232,160,32,.16);color:var(--warn);border-color:rgba(232,160,32,.3)}
.badge.off{background:rgba(255,77,79,.16);color:var(--err2);border-color:rgba(255,77,79,.32)}
/* Đếm người trong vùng (AreaRuleData) — con số real-time, không phải cảnh báo */
.badge.t-area{background:rgba(95,227,208,.14);color:var(--teal);border-color:rgba(95,227,208,.32)}
.t-bot{position:absolute;bottom:8px;left:10px;right:10px;display:flex;align-items:center;gap:8px}
.t-meta,.t-note{font:500 9.5px/1 var(--m);color:#b9c4cd;text-shadow:0 1px 3px rgba(0,0,0,.8);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.empty{grid-column:1/-1;display:flex;flex-direction:column;align-items:center;gap:9px;
  padding:60px 0;color:var(--ghost)}
.empty .plus{font:300 34px/1 var(--m);color:var(--bd3)}
.empty .t{font:500 12.5px/1 var(--b)}
.pager{flex:none;display:flex;align-items:center;justify-content:space-between;gap:10px;
  padding:12px 0 0}
.pager .mid{display:flex;align-items:center;gap:10px}
.pg{width:27px;height:27px;background:var(--field);border:1px solid var(--bd3);border-radius:5px;
  color:var(--dim);font:500 11px/1 var(--m);cursor:pointer}
.pg.on{background:var(--grad);color:#08090b;border-color:transparent}
.dis{opacity:.4;pointer-events:none}
.range{font:400 10.5px/1 var(--m);color:var(--ghost)}

/* ---------- DETAIL ---------- */
.split{flex:1;display:flex;min-height:0}
.stage-wrap{flex:1;display:flex;flex-direction:column;min-width:0;min-height:0;overflow:hidden;
  padding:14px 12px 14px 18px;gap:10px}
.stage{position:relative;flex:1;min-height:0;background:#0a0d12;border:1px solid var(--bd);
  border-radius:9px;overflow:hidden}
.stage video-stream,.stage video{position:absolute;inset:0;width:100%;height:100%;
  object-fit:contain;border-radius:9px}
/* z-index 4: PHAI cao hon .vod-v (2) va .vod-msg (3), neu khong clip xem lai se
   che mat nut LIVE -> khong con duong quay ve luong truc tiep. */
.s-top{position:absolute;z-index:4;top:11px;left:13px;right:13px;display:flex;
  align-items:center;gap:9px}
.s-bot{position:absolute;z-index:4;bottom:11px;left:13px;right:13px;display:flex;
  align-items:center;gap:8px}
.s-bot button{width:31px;height:31px;background:rgba(8,11,16,.72);border:1px solid var(--bd3);
  border-radius:6px;color:var(--fg2);cursor:pointer;font-size:12px}
.s-bot button:hover{border-color:var(--gold3);color:var(--gold2)}
.live{display:flex;align-items:center;gap:6px;font:600 9.5px/1 var(--m);color:var(--ok);
  background:rgba(8,11,16,.72);padding:5px 8px;border-radius:4px;letter-spacing:.06em}
.live .dot{width:6px;height:6px;border-radius:50%;background:var(--ok);
  animation:omPulse 1.6s ease-in-out infinite}
.qual{font:400 10px/1 var(--m);color:#b9c4cd;background:rgba(8,11,16,.72);padding:5px 8px;
  border-radius:4px}
aside{flex:none;width:320px;padding:14px 18px 14px 12px;display:flex;flex-direction:column;
  gap:10px;overflow:auto}
.card{background:var(--card2);border:1px solid var(--bd);border-radius:8px;padding:11px 13px;
  display:flex;flex-direction:column;gap:9px}
.card-h{font:600 9.5px/1 var(--m);letter-spacing:.1em;color:var(--gold);text-transform:uppercase}
.row{display:flex;align-items:center;gap:9px;justify-content:space-between}
.rk{font:500 11px/1.3 var(--b);color:var(--ghost);flex:none}
.rv{font:500 11px/1.3 var(--m);color:var(--fg2);text-align:right;min-width:0;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rv.ok{color:var(--ok)} .rv.warn{color:var(--warn)} .rv.err{color:var(--err2)}
.rv.dim{color:var(--ghost)} .rv.none{color:var(--bd3)}

/* lich su canh bao duoi stream */
.hist-bar{flex:none;height:150px;box-sizing:border-box;background:var(--card2);
  border:1px solid var(--bd);border-radius:8px;
  padding:9px 11px;display:flex;flex-direction:column;gap:8px}
.hist-h{display:flex;align-items:center;gap:9px}
.hist-t{font:600 9.5px/1 var(--m);letter-spacing:.1em;color:var(--gold)}
.hist-n{font:400 10px/1 var(--m);color:var(--ghost)}
.hist-list{flex:1;min-height:0;display:flex;align-items:flex-start;gap:8px;
  overflow-x:auto;overflow-y:hidden;padding-bottom:2px}
.h-item{flex:none;width:132px;border:1px solid var(--bd3);border-radius:6px;overflow:hidden;
  cursor:pointer;background:var(--card)}
.h-item:hover{border-color:var(--gold3)}
.h-item.on{border-color:var(--gold)}
.h-item img{width:100%;height:74px;object-fit:cover;display:block;background:#0a0d12}
.h-noimg{width:100%;height:74px;display:grid;place-items:center;font:400 9px/1 var(--m);
  color:var(--bd3)}
.h-meta{padding:5px 6px;display:flex;flex-direction:column;gap:2px}
.h-algo{font:500 10px/1.25 var(--b);color:var(--fg2);overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap}
.h-time{font:400 9px/1 var(--m);color:var(--ghost)}
.h-none{font:400 10.5px/1 var(--m);color:var(--bd3);padding:6px 2px}

/* ---------- CAMERA table (7 cot) ---------- */
.tbl{display:flex;flex-direction:column;min-width:820px}
.thead,.trow{display:grid;gap:10px;align-items:center;
  grid-template-columns:56px minmax(150px,1.3fr) minmax(96px,.8fr) minmax(180px,1.6fr) 74px 92px 104px}
.thead{padding:0 11px 8px;border-bottom:1px solid var(--bd4)}
.thead span{font:600 9.5px/1 var(--m);letter-spacing:.09em;color:var(--ghost);text-transform:uppercase}
.trow{padding:10px 11px;border-bottom:1px solid var(--bd2);cursor:pointer}
.trow:hover{background:#0d131b}
.c-id{font:600 11.5px/1 var(--m);color:var(--gold)}
.c-nm{font:500 12.5px/1.3 var(--b);color:var(--fg);overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap}
.c-md{font:400 10px/1.3 var(--m);color:var(--ghost);overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap}
.c-zone,.c-url,.c-lat{font:400 10.5px/1.3 var(--m);color:var(--dim);overflow:hidden;
  text-overflow:ellipsis;white-space:nowrap}
.c-url{color:var(--ghost)}
.c-st{display:flex;align-items:center;gap:6px;font:600 9.5px/1 var(--m);color:var(--ok);
  letter-spacing:.05em}
.c-st .dot{width:6px;height:6px;border-radius:50%;background:var(--ok);flex:none}
.c-st.off{color:var(--err2)} .c-st.off .dot{background:var(--err)}
.c-act{display:flex;align-items:center;gap:3px;justify-content:flex-end}
.c-algos{display:flex;gap:4px;flex-wrap:wrap;margin-top:3px}
.c-tag{font:500 9px/1 var(--m);color:var(--gold);background:rgba(217,162,51,.12);
  border:1px solid rgba(217,162,51,.28);border-radius:3px;padding:3px 5px;white-space:nowrap}
.c-none{font:400 9.5px/1 var(--m);color:var(--bd3)}

/* Ket qua Auto Search: nam trong cung scroll voi bang camera, khong phu len luoi. */
.discover-box{margin:0 0 14px;border:1px solid var(--bd3);border-radius:6px;overflow:hidden;
  background:var(--card)}
.d-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(90px,.45fr) auto;gap:10px;
  align-items:center;padding:8px 11px;border-bottom:1px solid var(--bd2)}
.d-row:last-child{border-bottom:0}
.d-ip{font:600 11px/1 var(--m);color:var(--gold);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.d-mf{font:400 10px/1 var(--m);color:var(--dim);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.d-add{justify-self:end}

/* ---------- LOG: timeline 3 cot (thoi gian | cham moc | su kien) ---------- */
.tl-day{display:flex;align-items:center;gap:11px;padding:0 2px 12px}
.tl-day .d{font:700 10.5px/1 var(--b);letter-spacing:.16em;text-transform:uppercase;
  color:#7d8a97;white-space:nowrap}
.tl-day .ln{flex:1;height:1px;background:#171e25}
.tl{display:flex;flex-direction:column;padding-left:16px}
.tl-row{--tl-anchor:29px;display:grid;grid-template-columns:82px 26px minmax(0,1fr);
  align-items:stretch;cursor:pointer;border-radius:9px;transition:background .18s ease}
.tl-row:hover{background:#0d131b}
.tl-t{display:flex;align-items:baseline;justify-content:flex-end;gap:1px;
  padding:calc(var(--tl-anchor) - 8px) 0 15px 4px}
.tl-hm{font:500 16px/1 var(--m);color:#c9d4de}
.tl-sec{font:400 12px/1 var(--m);color:#5c6a77}
/* cot giua: duong ke doc chay suot + cham moc tron */
.tl-mid{position:relative;display:flex;justify-content:center}
.tl-mid .ln{width:1px;background:#1b232b}
.tl-dot{position:absolute;top:calc(var(--tl-anchor) - 6px);width:12px;height:12px;border-radius:50%;
  box-shadow:0 0 0 3px var(--bg),0 0 10px currentColor}
.tl-b{display:flex;align-items:center;gap:17px;padding:12px 0 12px 18px;
  border-bottom:1px solid #12181f;min-width:0}
.tl-th{position:relative;flex:none;width:160px;aspect-ratio:16/9;border-radius:6px;
  overflow:hidden;background:#0a0d12}
.tl-th img{width:100%;height:100%;object-fit:cover;display:block}
.tl-th .sc{position:absolute;inset:0;pointer-events:none;
  background:repeating-linear-gradient(0deg,rgba(255,255,255,.04) 0 1px,transparent 1px 3px)}
.tl-th .cam{position:absolute;bottom:6px;left:7px;font:500 11px/1 var(--m);color:#fff;
  text-shadow:0 1px 2px #000}
.tl-th .no{position:absolute;inset:0;display:grid;place-items:center;font:400 9.5px/1 var(--m);
  color:var(--bd3)}
.tl-mn{flex:1;min-width:0;display:flex;flex-direction:column;gap:6px}
.tl-chips{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.tl-kind{font:700 11px/1 var(--m);letter-spacing:.1em;background:rgba(255,255,255,.03);
  border:1px solid;border-radius:99px;padding:6px 11px;white-space:nowrap}
.tl-new{font:700 9px/1 var(--m);letter-spacing:.08em;color:#fff;background:var(--err);
  border-radius:99px;padding:5px 8px;white-space:nowrap}
.tl-ttl{font:600 17px/1.25 var(--b);color:var(--fg);overflow:hidden;
  text-overflow:ellipsis;white-space:nowrap}
.tl-sub{font:400 12px/1.3 var(--m);color:#7d8a97;overflow:hidden;
  text-overflow:ellipsis;white-space:nowrap}
.tl-r{flex:none;display:flex;flex-direction:column;align-items:flex-end;gap:7px;padding-right:4px}
.tl-conf{font:600 11.5px/1 var(--m)}
.tl-bar{width:64px;height:3px;border-radius:2px;background:#1b232b;overflow:hidden}
.tl-bar i{display:block;height:100%}
.tl-more{font:500 13px/1 var(--b);color:#8a6a2c;white-space:nowrap}

/* ---------- SETTINGS ---------- */
.cn-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(186px,1fr));gap:11px}
.field{display:flex;flex-direction:column;gap:5px;min-width:0}
.field label{font:600 9.5px/1 var(--m);letter-spacing:.08em;color:var(--ghost);text-transform:uppercase}
.field input,.field select{background:var(--field);border:1px solid var(--bd3);border-radius:5px;
  padding:8px 10px;color:var(--fg);font:500 12px/1 var(--b);outline:none;min-width:0}
.field input.mono{font-family:var(--m);font-size:11.5px}
.field input:focus,.field select:focus{border-color:var(--gold3)}
.hint{font:400 10px/1.4 var(--m);color:var(--ghost)}
.cn-foot,.al-foot{display:flex;align-items:center;gap:9px;padding-top:3px;flex-wrap:wrap}
.cn-state{font:500 11px/1 var(--m);color:var(--ghost)}
.cn-state.ok{color:var(--ok)} .cn-state.err{color:var(--err2)}

/* chon 20 thuat toan, nhom theo Algorithm Function */
.al-head{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
.al-cnt{font:500 11px/1 var(--m);color:var(--gold)}
.al-cnt.full{color:var(--warn)}
/* Bang 2 cot: trai = Category, phai = Algorithm Function. Cot trai dat WIDTH CO DINH
   (khong phai minmax/fr) vi moi .al-cat la mot grid rieng — chi width co dinh moi canh
   thang cot giua cac hang va voi hang tieu de .al-thead nam ngoai #alCats. */
#alCats{border:1px solid var(--bd3);border-top:none;border-radius:0 0 6px 6px;
  overflow:hidden}
.al-thead{display:grid;grid-template-columns:200px 1fr;background:var(--card2);
  border:1px solid var(--bd3);border-radius:6px 6px 0 0;border-bottom:none;
  /* .card la flex column co gap:9px -> thead va #alCats la 2 flex item bi day roi
     nhau. Trieu tieu dung gap de hai nua ghep thanh mot khung lien. */
  margin-bottom:-9px}
.al-thead>span{padding:8px 11px;font:600 10px/1 var(--b);letter-spacing:.08em;
  color:var(--ghost);text-transform:uppercase}
.al-thead>span:first-child{border-right:1px solid var(--bd3)}
.al-cat{display:grid;grid-template-columns:200px 1fr;border-top:1px solid var(--bd3)}
.al-cat-h{display:flex;flex-direction:column;justify-content:center;gap:4px;
  padding:9px 11px;background:var(--card2);border-right:1px solid var(--bd3)}
.al-cat-n{font:600 11.5px/1.3 var(--b);color:var(--fg2)}
.al-cat-c{font:400 9.5px/1 var(--m);color:var(--ghost)}
.al-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(196px,1fr));gap:6px;
  padding:8px 9px;min-width:0}
.al-item{display:flex;align-items:center;gap:8px;padding:8px 10px;background:var(--field);
  border:1px solid var(--bd3);border-radius:5px;cursor:pointer;min-width:0}
.al-item:hover{border-color:var(--gold3)}
.menu .mrow.on .al-box{background:var(--gold);border-color:var(--gold)}
.menu .mrow.on .al-box::after{content:'';width:7px;height:4px;border-left:1.6px solid #08090b;
  border-bottom:1.6px solid #08090b;transform:rotate(-45deg) translate(1px,-1px)}

.al-item.on{border-color:var(--gold);background:rgba(217,162,51,.09)}
.al-item.dis{opacity:.42;cursor:not-allowed}
.al-box{width:13px;height:13px;border-radius:3px;border:1px solid var(--bd3);flex:none;
  display:grid;place-items:center}
.al-item.on .al-box{background:var(--gold);border-color:var(--gold)}
.al-item.on .al-box::after{content:'';width:7px;height:4px;border-left:1.6px solid #08090b;
  border-bottom:1.6px solid #08090b;transform:rotate(-45deg) translate(1px,-1px)}
.al-nm{font:400 11.5px/1.3 var(--b);color:var(--dim);overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap}
.al-item.on .al-nm{color:var(--fg)}
.al-load{font:400 11px/1.5 var(--m);color:var(--ghost);padding:10px 2px}

/* ---------- toast: xep tang o goc duoi-trai, 1:1 theo design ---------- */
/* width co dinh 376px; cac toast cu xep chong SAU toast moi nhat (translateY am
   + scale nho dan), khong phai xep thanh cot. */
#toasts{position:fixed;left:18px;bottom:18px;z-index:60;width:376px}
.toast{position:absolute;left:0;right:0;bottom:0;transform-origin:bottom center;
  display:flex;flex-direction:column;background:var(--card2);
  border:1px solid #242d36;border-radius:9px;overflow:hidden;
  box-shadow:0 16px 40px rgba(0,0,0,.68);
  animation:omToastIn .28s ease-out,omShake .3s ease-in-out .28s 1;
  transition:transform .22s ease,opacity .22s ease}
.toast.err{border-color:rgba(255,77,79,.4)}
/* border-top day mau theo loai canh bao */
.toast{border-top-width:1px;border-top-style:solid}

.t-h{display:flex;align-items:center;gap:9px;padding:9px 12px 8px}
.t-dot{width:8px;height:8px;border-radius:50%;flex:none;
  animation:omPulse 1.4s ease-in-out infinite}
.t-sev{font:700 10px/1 var(--m);letter-spacing:.1em;white-space:nowrap}
.t-older{font:500 10px/1 var(--m);color:var(--gold);background:#1b232b;
  border:1px solid #6b4f1c;padding:4px 7px;border-radius:99px;white-space:nowrap}
.t-time{font:400 11px/1 var(--m);color:var(--ghost)}
.t-x{font:500 14px/1 var(--m);color:#5c6a77;cursor:pointer;padding-left:4px;
  background:none;border:none}
.t-x:hover{color:var(--gold2)}

/* anh phat hien: khung 21/9 nhu design */
.t-img{position:relative;width:100%;aspect-ratio:21/9;object-fit:cover;
  background:#0a0d12;display:block;cursor:pointer;border:none}
.t-noimg{width:100%;aspect-ratio:21/9;display:grid;place-items:center;background:#0a0d12;
  font:400 10px/1 var(--m);color:var(--bd3)}
.t-cam{position:absolute;bottom:7px;left:9px;font:500 10.5px/1 var(--m);color:#fff;
  background:rgba(8,10,13,.66);padding:4px 7px;border-radius:3px;pointer-events:none}
.t-shot{position:relative}
.t-shot .lines{position:absolute;inset:0;pointer-events:none;border-radius:0;
  background:repeating-linear-gradient(0deg,rgba(255,255,255,.04) 0 1px,transparent 1px 3px)}

.t-body{padding:11px 13px 13px;display:flex;flex-direction:column;gap:5px}
.t-ttl{font:600 16.5px/1.25 var(--b);color:var(--fg)}
.t-sub{font:400 11.5px/1.35 var(--m);color:var(--dim)}
.t-acts{display:flex;gap:8px;margin-top:7px}
.t-acts .go{flex:1;font:600 12.5px/1 var(--b);color:#08090b;border:none;border-radius:5px;
  padding:10px 14px;cursor:pointer;white-space:nowrap;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.2),0 1px 3px rgba(0,0,0,.5)}
.t-acts .skip{flex:none;font:600 12.5px/1 var(--b);color:var(--gold);background:transparent;
  border:1px solid #26303a;border-radius:5px;padding:10px 14px;cursor:pointer;white-space:nowrap}
.t-acts .skip:hover{color:var(--gold2)}

/* ---------- overlay / modal ---------- */
.overlay{position:fixed;inset:0;z-index:150;background:rgba(4,6,10,.72);display:grid;
  place-items:center;padding:24px}
.modal{width:min(880px,100%);max-height:100%;display:flex;flex-direction:column;
  background:var(--card2);border:1px solid var(--bd3);border-radius:9px;overflow:hidden;
  box-shadow:0 16px 40px rgba(0,0,0,.68)}
.m-head{flex:none;display:flex;align-items:center;gap:10px;padding:13px 16px;
  border-bottom:1px solid var(--bd2)}
.m-title{font:600 14px/1 var(--b)}
.m-x{background:none;border:none;color:var(--ghost);cursor:pointer;font-size:14px}
.m-x:hover{color:var(--fg2)}
.m-body{flex:1;overflow:auto;display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:16px}
.m-col{display:flex;flex-direction:column;gap:11px;min-width:0}
.m-foot{flex:none;display:flex;align-items:center;gap:9px;padding:12px 16px;
  border-top:1px solid var(--bd2)}
.preview{background:#0a0d12;border:1px solid var(--bd3);border-radius:8px;display:grid;
  place-items:center;aspect-ratio:16/9;overflow:hidden}
.preview .msg{font:400 10.5px/1.4 var(--m);color:var(--ghost);text-align:center;padding:0 12px}
@media (max-width:760px){.m-body{grid-template-columns:1fr}}

/* ---------- xem lai clip: chieu tren chinh khung stage ---------- */
.vod-v{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;
  background:#000;z-index:2}
.vod-msg{position:absolute;inset:0;z-index:3;display:grid;place-items:center;
  pointer-events:none;font:400 11.5px/1.5 var(--m);color:var(--dim);text-align:center;
  padding:0 30px;background:rgba(4,6,10,.55)}
.vod-msg.err{color:var(--err2)}
/* Nut play/mute/fullscreen cua luong live vo nghia khi dang xem clip, va no nam
   dung cho controls cua <video> -> an di trong luc xem lai. */
#stage:has(.vod-v) .s-bot{display:none}
/* Dang XEM LAI: xam, cham khong nhay, bam duoc de ve luong truc tiep.
   Dang LIVE: xanh + cham nhay (mac dinh .live o tren). */
#dLive.back{color:var(--dim);cursor:pointer}
#dLive.back .dot{background:var(--ghost);animation:none}
#dLive.back:hover{color:var(--gold2)}
#dLive.back:hover .dot{background:var(--gold)}
/* Luong live chua len hinh -> mo di, nhung KHONG duoc de opacity inline de con
   phan biet duoc voi trang thai xem lai. */
#dLive.wait{opacity:.35}
.h-item .h-play{position:absolute;inset:0;display:grid;place-items:center;
  background:rgba(4,6,10,.42);opacity:0;transition:opacity .15s ease;pointer-events:none}
.h-item{position:relative}
.h-item:hover .h-play{opacity:1}
.h-play span{width:22px;height:22px;border-radius:50%;background:rgba(217,162,51,.92);
  color:#08090b;display:grid;place-items:center;font-size:9px;padding-left:2px}
.tl-row .tl-th{position:relative}
.tl-th .tl-play{position:absolute;inset:0;display:grid;place-items:center;
  background:rgba(4,6,10,.38);opacity:0;transition:opacity .15s ease}
.tl-row:hover .tl-th .tl-play{opacity:1}
.tl-play span{width:26px;height:26px;border-radius:50%;background:rgba(217,162,51,.92);
  color:#08090b;display:grid;place-items:center;font-size:10px;padding-left:2px}

/* ---------- CAU HINH AI: layout 1:1 theo design ---------- */
.ai-wrap{flex:1;min-height:0;overflow:auto;padding:14px 18px 18px;display:flex;
  flex-direction:column;animation:omViewIn .3s cubic-bezier(.2,.8,.2,1) both}

/* tab tung thuat toan dang bat tren camera nay */
.fn-tabs{flex:none;display:flex;align-items:center;gap:2px;flex-wrap:wrap;
  border-bottom:1px solid #1b222a;margin-bottom:16px}
.fn-tab{display:flex;align-items:center;gap:10px;padding:11px 15px;margin-bottom:-1px;
  border:none;border-bottom:2px solid transparent;background:transparent;
  border-radius:7px 7px 0 0;cursor:pointer;white-space:nowrap;transition:background .16s ease}
.fn-tab .d{width:7px;height:7px;border-radius:50%;background:#38424c;flex:none}
.fn-tab .l{font:600 12.5px/1 var(--b);color:var(--dim)}
.fn-tab .x{font:400 12px/1 var(--m);color:#4a5764}
.fn-tab .x:hover{color:var(--err2)}
.fn-tab.on{border-bottom-color:var(--gold);background:var(--field)}
.fn-tab.on .d{background:var(--gold)}
.fn-tab.on .l{color:var(--gold)}
.fn-add{display:flex;align-items:center;gap:7px;margin:0 0 3px 8px;padding:8px 12px;
  border-radius:7px;background:var(--field);border:1px dashed #2a333c;color:var(--gold);
  cursor:pointer;white-space:nowrap}
.fn-add:hover{border-color:var(--gold3)}
.fn-add .p{font:500 14px/1 var(--m)}
.fn-add .t{font:600 11.5px/1 var(--b)}
.fn-none{font:400 11px/1 var(--m);color:var(--ghost);padding:11px 4px}

.ai-cols{flex:1;min-height:0;display:grid;grid-template-columns:minmax(0,1fr) 386px;gap:16px}
.ai-left{display:flex;flex-direction:column;gap:12px;min-width:0}

/* anh + canvas ve vung */
.ai-shot{position:relative;aspect-ratio:16/9;background:#0a0d12;border:1px solid var(--bd);
  border-radius:9px;overflow:hidden}
/* #aiShot la khung chua <video-stream> (stream song), khong con <img> */
.ai-shot #aiShot{position:absolute;inset:0}
.ai-shot video-stream,.ai-shot video-stream video{width:100%;height:100%;display:block}
.ai-shot video-stream video{object-fit:contain;background:#0a0d12}
/* Con tro do JS dat theo mode (mac dinh 'default', 'crosshair' khi dang ve).
   De crosshair o day thi luc KHONG ve chuot van la dau cong. */
.ai-shot canvas{position:absolute;inset:0;width:100%;height:100%;cursor:default}
.ai-shot-top{position:absolute;top:11px;left:13px;display:flex;align-items:center;gap:8px;
  pointer-events:none}
.ai-dot{width:6px;height:6px;border-radius:50%;background:var(--ok);
  animation:omPulse 1.6s ease-in-out infinite}
.ai-q{font:500 10px/1 var(--m);color:#c9d4de;background:rgba(8,10,13,.7);padding:6px 9px;
  border-radius:99px}
.ai-tools{flex:none;display:flex;align-items:center;gap:8px;flex-wrap:wrap}

/* danh sach vung da ve */
.zone-list{display:flex;flex-direction:column;gap:7px}
.zone{display:flex;align-items:center;gap:11px;background:var(--head);border:1px solid var(--bd);
  border-radius:8px;padding:10px 12px}
.zone .sw{width:9px;height:9px;border-radius:2px;flex:none}
.zone .nm{font:600 12px/1 var(--b);color:var(--fg);white-space:nowrap}
.zone .mt{font:400 10.5px/1 var(--m);color:#7d8a97;white-space:nowrap}
.zone .act{font:500 11px/1 var(--b);color:var(--dim);cursor:pointer;white-space:nowrap;
  background:none;border:none;padding:0}
.zone .act:hover{color:var(--gold2)}
.zone .act.rm:hover{color:var(--err2)}
/* Vung dang duoc chon: to dam o day VA dam net tren anh (draw() dung P.pick) */
.zone{cursor:pointer}
.zone.on{border-color:var(--gold3);background:var(--hov)}
.zone.on .nm{color:var(--gold2)}
.zone-none{font:400 10.5px/1.5 var(--m);color:var(--bd3);padding:4px 2px}

/* cot phai: 3 tab con */
.ai-right{display:flex;flex-direction:column;background:var(--head);border:1px solid var(--bd);
  border-radius:9px;overflow:hidden;min-width:0}
.cfg-tabs{flex:none;display:flex;align-items:center;gap:4px;padding:9px 8px;
  border-bottom:1px solid #171e25;overflow-x:auto}
.cfg-tabs button{flex:none;padding:8px 10px;border-radius:6px;background:transparent;border:none;
  cursor:pointer;white-space:nowrap;font:600 11px/1 var(--b);color:var(--dim)}
.cfg-tabs button.on{background:var(--grad);color:#08090b;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.2),0 1px 3px rgba(0,0,0,.5)}
.cfg-pane{flex:1;min-height:0;overflow:auto;padding:14px}

/* nhom truong trong tab con */
.cfg-h{font:700 10px/1 var(--b);letter-spacing:.16em;text-transform:uppercase;color:var(--ghost);
  margin-bottom:12px}
.cfg-sep{height:1px;background:#171e25;margin:16px 0 14px}
.cfg-rows{display:flex;flex-direction:column;gap:12px}
.cfg-row{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:12px}
.cfg-lb{display:flex;flex-direction:column;gap:3px;min-width:0}
.cfg-lb .l{font:500 12px/1.3 var(--b);color:#c9d4de}
.cfg-lb .h{font:400 10px/1.3 var(--m);color:#5c6a77}
/* o so co nut -/+ thay vi thanh truot */
.spin{display:flex;align-items:center;border:1px solid var(--bd3);border-radius:6px;
  overflow:hidden;background:var(--field);flex:none}
.spin button{width:28px;height:32px;display:grid;place-items:center;font:500 14px/1 var(--m);
  color:var(--dim);cursor:pointer;user-select:none;background:none;border:none}
.spin button:hover{color:var(--gold2);background:var(--hov)}
.spin .v{min-width:44px;text-align:center;font:500 11.5px/1 var(--m);color:var(--fg);
  padding:9px 2px;background:none;border:none;outline:none}
.cfg-sz{display:flex;flex-direction:column;gap:10px}
.cfg-sz-g{display:flex;flex-direction:column;gap:7px}
.cfg-sz-g>.l{font:500 11.5px/1 var(--b);color:#c9d4de}
.cfg-sz-r{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.cfg-ax{display:flex;align-items:center;gap:8px;min-width:0}
.cfg-ax>.a{font:400 10.5px/1 var(--m);color:var(--ghost);white-space:nowrap}
.cfg-ax .spin{flex:1;min-width:0}

/* chon loai doi tuong: dropdown chip */
.obj-wrap{position:relative}
.obj-head{display:flex;align-items:center;gap:6px;flex-wrap:wrap;padding:8px 10px;
  background:var(--field);border:1px solid var(--bd3);border-radius:6px;cursor:pointer}
.obj-head.open{border-color:var(--gold3)}
.obj-chip{font:500 10.5px/1 var(--m);color:#c9d4de;background:#1b232b;border:1px solid #2a333c;
  border-radius:4px;padding:5px 7px;white-space:nowrap}
.obj-chip.none{color:#5c6a77;background:transparent;border-color:transparent}
.obj-caret{font:400 9px/1 var(--m);color:#5c6a77;flex:none;margin-left:auto}
.obj-menu{position:absolute;top:calc(100% + 5px);left:0;right:0;z-index:20;padding:5px;
  background:var(--card2);border:1px solid var(--bd3);border-radius:7px;
  box-shadow:0 14px 34px rgba(0,0,0,.6)}
.obj-item{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:5px;cursor:pointer}
.obj-item:hover{background:var(--hov)}
.obj-item.on{background:var(--hov)}
.obj-box{width:14px;height:14px;border-radius:3px;border:1px solid #3a4550;flex:none;
  display:grid;place-items:center}
.obj-item.on .obj-box{background:var(--gold);border-color:var(--gold3)}
.obj-item.on .obj-box::after{content:'';width:7px;height:4px;border-left:1.6px solid #08090b;
  border-bottom:1.6px solid #08090b;transform:rotate(-45deg) translate(1px,-1px)}
.obj-item .l{font:500 11.5px/1 var(--b);color:#9fb0be}
.obj-item.on .l{color:var(--fg)}

/* cong tac bat/tat cho tab Lien ket */
.sw-row{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:7px;
  border:1px solid var(--bd);cursor:pointer}
.sw-row.on{background:var(--field);border-color:#33404c}
.sw-row .tx{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
.sw-row .l{font:500 12px/1.3 var(--b);color:var(--dim)}
.sw-row.on .l{color:var(--fg)}
.sw-row .m{font:400 10px/1.3 var(--m);color:#5c6a77}
.sw-tr{width:34px;height:18px;border-radius:99px;background:#222a32;flex:none;position:relative;
  transition:background .16s ease}
.sw-row.on .sw-tr{background:var(--gold3)}
.sw-kn{position:absolute;top:2px;left:2px;width:14px;height:14px;border-radius:50%;
  background:#5c6a77;transition:transform .16s ease,background .16s ease}
.sw-row.on .sw-kn{background:var(--head);transform:translateX(16px)}

/* luoi lich 7x24 */
.sc-tools{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:11px}
.sc-preset{font:500 10.5px/1 var(--m);color:var(--dim);background:var(--field);
  border:1px solid var(--bd3);border-radius:99px;padding:6px 10px;cursor:pointer;white-space:nowrap}
.sc-preset:hover{border-color:var(--gold3);color:var(--gold2)}
.sc-grid{display:flex;flex-direction:column;gap:4px}
.sc-axis{display:grid;grid-template-columns:34px minmax(0,1fr);gap:8px;align-items:center}
.sc-axis .hh{display:flex;justify-content:space-between;font:400 8.5px/1 var(--m);color:#4a5764}
.sc-row{display:grid;grid-template-columns:34px minmax(0,1fr);gap:8px;align-items:center}
.sc-day{font:500 10px/1 var(--m);color:var(--dim);cursor:pointer;white-space:nowrap;
  background:none;border:none;padding:0;text-align:left}
.sc-day:hover{color:var(--gold2)}
.sc-cells{display:grid;grid-template-columns:repeat(24,minmax(0,1fr));gap:1px}
.sc-cell{height:17px;background:#141b22;border-radius:1px;cursor:pointer}
.sc-cell:hover{outline:1px solid var(--gold3)}
.sc-cell.on{background:var(--gold3)}
.sc-sum{font:400 10px/1.5 var(--m);color:var(--ghost);margin-top:10px}

/* ---------- popup nap thuat toan cho camera ---------- */
.fp-cap{flex:none;display:flex;align-items:center;gap:10px;padding:11px 16px;
  border-bottom:1px solid var(--bd2);background:var(--head)}
.fp-cap-k{font:600 9.5px/1 var(--m);letter-spacing:.09em;color:var(--ghost)}
.fp-cap-v{font:700 15px/1 var(--m);color:var(--ok);min-width:46px}
.fp-cap-v.warn{color:var(--warn)}
.fp-cap-v.err{color:var(--err2)}
.fp-bar{width:150px;height:4px;border-radius:2px;background:#1b232b;overflow:hidden}
.fp-bar i{display:block;height:100%;background:var(--ok);transition:width .2s ease}
.fp-bar i.warn{background:var(--warn)}
.fp-bar i.err{background:var(--err)}
.fp-body{flex:1;min-height:0;overflow:auto;padding:14px 16px;display:grid;
  grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:7px;align-content:start}
