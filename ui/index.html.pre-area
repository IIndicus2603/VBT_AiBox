<meta charset="utf-8">
<title>Vibotics · AI Smart Box</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Saira+Condensed:wght@700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">

<div id="app">
  <header>
    <div style="display:flex;align-items:center;gap:10px">
      <div class="logo"></div>
      <div style="display:flex;flex-direction:column;gap:1px">
        <span class="brand">Vibotics</span>
        <span class="brand-sub">AI Smart Box</span>
      </div>
    </div>
    <div class="chip"><span class="k">SITE</span><span class="v" id="site">C27</span>
      <span style="color:var(--ghost);font-size:10px">▾</span></div>
    <div class="grow"></div>
    <nav>
      <button data-go="live" class="on" title="Live"><svg viewBox="0 0 24 24"><path
        d="M4 4.5h6.2v6.2H4zM13.8 4.5H20v6.2h-6.2zM4 13.3h6.2v6.2H4zM13.8 13.3H20v6.2h-6.2z"/></svg></button>
      <button data-go="log" title="Nhật ký"><svg viewBox="0 0 24 24"><path
        d="M12 3.2a8.8 8.8 0 1 0 0 17.6 8.8 8.8 0 0 0 0-17.6zM12 7.6V12l3.4 2.1"/></svg>
        <span class="badge" id="navUnread" hidden>0</span></button>
      <button data-go="cam" title="Camera"><svg viewBox="0 0 24 24"><path
        d="M3.4 7.6h11.2v8.8H3.4zM14.6 10.6l6-2.6v8.4l-6-2.6M6 4.4h5.6"/></svg></button>
      <button data-go="cfg" title="Cấu hình"><svg viewBox="0 0 24 24"><path
        d="M4 7.4h7.6M15.4 7.4H20M4 16.6h4.6M12.4 16.6H20M13.4 7.4a1.9 1.9 0 1 0 0-.1M10.8 16.6a1.9 1.9 0 1 0 0-.1"/></svg></button>
    </nav>
    <div class="grow"></div>
    <div class="stat"><span class="dot" id="dGo"></span><span id="cOnline">—</span></div>
    <div class="stat" id="sBox"><span class="dot" id="dBox"></span><span id="cBox">AI BOX …</span></div>
    <span id="clock">--:--:--</span>
    <div class="avatar">TT</div>
  </header>

  <div class="body">
    <main>
      <!-- ===== LIVE ===== -->
      <section class="view" id="v-live">
        <div class="bar">
          <span class="h1">Tất cả camera</span>
          <span class="sub" id="camCount">—</span>
          <div class="grow"></div>
          <div class="drop">
            <button class="btn" id="fBtn"><span style="font:400 10px/1 var(--m);color:var(--ghost)">LỌC</span>
              <span id="fLabel">Tất cả</span><span style="color:var(--ghost);font-size:10px">▾</span></button>
            <div class="menu" id="fMenu" hidden>
              <div id="fList"></div>
              <div class="msep"></div>
              <div class="mrow"><span class="l">Bố cục</span>
                <div class="seg" id="layout">
                  <button data-cols="2">2×2</button>
                  <button data-cols="3" class="on">3×3</button>
                  <button data-cols="4">4×4</button>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="scroll" style="display:flex;flex-direction:column;overflow:hidden">
          <div style="flex:1;overflow:auto;min-height:0"><div id="grid"></div></div>
          <div class="pager" id="pager" hidden>
            <div></div>
            <div class="mid">
              <button class="btn" id="pgPrev">← Trước</button>
              <span id="pgNums" style="display:flex;gap:10px"></span>
              <button class="btn" id="pgNext">Sau →</button>
            </div>
            <span class="range" id="pgRange"></span>
          </div>
        </div>
      </section>

      <!-- ===== DETAIL ===== -->
      <section class="view" id="v-detail" hidden>
        <div class="bar">
          <button class="btn" id="back">← Tất cả camera</button>
          <div style="display:flex;flex-direction:column;gap:2px;min-width:0">
            <span class="h1" id="dName">—</span>
            <span class="sub q" id="dSrc">—</span>
          </div>
          <div class="grow"></div>
          <button class="btn-cy" id="dAI" data-sheen>Cấu hình AI</button>
          <button class="btn" id="dSnap">Lưu ảnh</button>
          <button class="btn btn-del" id="dDel">Xoá camera</button>
          <button class="btn" id="dReload">Tải lại luồng</button>
        </div>
        <div class="split">
          <div class="stage-wrap">
            <div class="stage" id="stage">
              <div class="lines"></div>
              <div class="s-top">
                <span class="live" id="dLive"><span class="dot"></span>LIVE</span>
                <span class="qual" id="dQual">—</span>
              </div>
              <div class="s-bot">
                <button id="dPlay" title="Tạm dừng">⏸</button>
                <button id="dMute" title="Bật tiếng">🔇</button>
                <button id="dFull" title="Toàn màn hình">⛶</button>
                <div class="grow"></div>
                <span class="qual" id="dUp">—</span>
              </div>
            </div>
            <div class="hist-bar">
              <div class="hist-h">
                <span class="hist-t">LỊCH SỬ CẢNH BÁO</span>
                <span class="hist-n" id="histN">—</span>
                <div class="grow"></div>
                <button class="btn" id="histAck" hidden>Bỏ qua cảnh báo</button>
              </div>
              <div class="hist-list nosb" id="hist"></div>
            </div>
          </div>
          <aside>
            <div class="card"><div class="card-h">Luồng RTSP</div><div id="dRows"></div></div>
            <div class="card"><div class="card-h">Phiên xem</div><div id="dRows2"></div></div>
            <div class="card"><div class="card-h">Thuật toán AI</div><div id="dAlgos"></div></div>
          </aside>
        </div>
      </section>

      <!-- ===== LOG ===== -->
      <section class="view" id="v-log" hidden>
        <div class="bar">
          <span class="h1">Nhật ký cảnh báo</span>
          <div class="grow"></div>
          <button class="btn" id="logRefresh">Làm mới</button>
        </div>
        <div class="scroll nosb"><div id="logBox"></div></div>
      </section>

      <!-- ===== CAMERA (bang 7 cot) ===== -->
      <section class="view" id="v-cam" hidden>
        <div class="bar">
          <span class="h1">Danh sách camera</span>
          <span class="sub">/api/cameras · trạng thái luồng RTSP</span>
          <div class="grow"></div>
          <div class="chip"><span class="k">CÔNG SUẤT CÒN</span><span class="v" id="camHr">—</span></div>
          <span class="hint" id="camSub">—</span>
          <div class="vr"></div>
          <button class="btn-cy" id="addBtn" data-sheen>
            <span style="font:500 14px/1 var(--m)">+</span>Thêm camera RTSP</button>
          <button class="btn" id="camReload">Làm mới</button>
        </div>
        <div class="scroll nosb">
          <div class="tbl">
            <div class="thead">
              <span>ID</span><span>Tên / Model</span><span>Khu vực</span><span>URL</span>
              <span>Độ trễ</span><span>Trạng thái</span><span style="text-align:right">Hành động</span>
            </div>
            <div id="camList"></div>
          </div>
        </div>
      </section>

      <!-- ===== CAU HINH AI (full page, 3 tab) ===== -->
      <section class="view" id="v-ai" hidden>
        <div class="bar">
          <button class="btn" id="aiBack">← Danh sách camera</button>
          <div style="display:flex;flex-direction:column;gap:2px;min-width:0">
            <span class="h1">Cấu hình AI · <span id="aiTitle">—</span></span>
            <span class="sub q" id="aiStream">—</span>
          </div>
          <div class="grow"></div>
          <span class="hint" id="aiHr">—</span>
          <button class="btn-gh" id="aiCancel">Hủy</button>
          <button class="btn-cy" id="aiSave" data-sheen>Lưu cấu hình</button>
        </div>

        <div class="ai-wrap nosb">
          <!-- tab tung thuat toan dang bat: cham mau + ten + dau X -->
          <div class="fn-tabs" id="aiFns"></div>

          <div class="ai-cols">
            <!-- cot trai: anh + ve vung + danh sach vung -->
            <div class="ai-left">
              <div class="ai-tools">
                <button class="btn-cy" id="aiDraw" data-sheen>
                  <svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:none;stroke:currentColor;
                       stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round"><path
                       d="M4 20h4L19.5 8.5a2.1 2.1 0 0 0-3-3L5 17v3M14.5 6.5l3 3"/></svg>Vẽ vùng</button>
                <button class="btn" id="aiClear">Xóa tất cả vùng</button>
                <div class="grow"></div>
                <span class="hint" id="aiHint">Chọn thuật toán trước khi vẽ vùng</span>
              </div>
              <div class="ai-shot" id="aiStage">
                <!-- Stream song thay vi api/frame.jpeg: frame.jpeg can ffmpeg, thieu la 500.
                     #aiShot giu lai lam khung do kich thuoc cho canvas (ResizeObserver). -->
                <div id="aiShot"></div>
                <canvas id="aiCv"></canvas>
                <div class="ai-shot-top">
                  <span class="ai-dot"></span>
                  <span class="ai-q" id="aiQual">—</span>
                </div>
              </div>
              <div class="zone-list" id="aiZones"></div>
            </div>

            <!-- cot phai: 3 tab con -->
            <div class="ai-right">
              <div class="cfg-tabs" id="aiTabs">
                <button data-t="rule" class="on">Quy tắc</button>
                <button data-t="sched">Lịch canh phòng</button>
                <button data-t="link">Liên kết hành động</button>
              </div>
              <div class="cfg-pane nosb" id="aiPane"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== CAU HINH HE THONG ===== -->
      <section class="view" id="v-cfg" hidden>
        <div class="bar">
          <span class="h1">Cấu hình hệ thống</span>
          <span class="sub q">Kết nối AI SmartBox &amp; thuật toán đang nạp</span>
          <div class="grow"></div>
          <span class="al-cnt" id="alCnt">—</span>
        </div>
        <div class="scroll nosb">
          <div class="card">
            <div class="card-h">Kết nối AI SmartBox</div>
            <div class="cn-grid">
              <div class="field"><label>IP / Hostname</label>
                <input id="cnHost" class="mono" placeholder="192.168.21.93" autocomplete="off"></div>
              <div class="field"><label>Cổng</label>
                <input id="cnPort" class="mono" type="number" min="1" max="65535" value="80"></div>
              <div class="field"><label>Tài khoản</label>
                <input id="cnUser" class="mono" placeholder="admin" autocomplete="off"></div>
              <div class="field"><label>Mật khẩu</label>
                <input id="cnPass" class="mono" type="password" placeholder="••••••"
                       autocomplete="new-password">
                <span class="hint">Bỏ trống = giữ mật khẩu đang dùng</span></div>
            </div>
            <div class="cn-foot">
              <span class="cn-state" id="cnState">Chưa kiểm tra</span>
              <div class="grow"></div>
              <button class="btn" id="cnTest">Kiểm tra kết nối</button>
              <button class="btn" id="cnSync">Đồng bộ camera</button>
              <div class="vr"></div>
              <button class="btn-cy" id="cnSave" data-sheen>Lưu</button>
            </div>
            <div class="hint">Mật khẩu lưu plaintext trong aibox.conf.json — đừng commit file này.</div>
          </div>
          <div class="card" style="margin-top:12px">
            <div class="al-head">
              <span class="card-h">Thuật toán box đang nạp</span>
              <span class="hint">Chọn kịch bản hoặc thuật toán cần nạp</span>
              <div class="grow"></div>
              <span class="al-cnt" id="alCnt2">—</span>
            </div>
            <div class="al-thead"><span>Category</span><span>Algorithm Function</span></div>
            <div id="alCats"></div>
            <div class="al-foot">
              <span class="hint" id="alHint">Box giới hạn 20 thuật toán nạp cùng lúc</span>
              <div class="grow"></div>
              <span class="cn-state" id="alState"></span>
              <button class="btn" id="alWeb">Đổi trên web box ↗</button>
              <button class="btn-cy" id="alSave" data-sheen>Nạp thuật toán</button>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <!-- ===== THEM CAMERA RTSP ===== -->
  <div class="overlay" id="modal" hidden>
    <div class="modal">
      <div class="m-head">
        <div style="display:flex;flex-direction:column;gap:3px">
          <span class="m-title">Thêm camera qua RTSP</span>
          <span class="sub q">PUT /api/streams · ghi thẳng vào go2rtc.yaml</span>
        </div>
        <div class="grow"></div>
        <button class="m-x" id="mClose">✕</button>
      </div>
      <div class="m-body">
        <div class="m-col">
          <div class="field"><label>URL RTSP</label>
            <input id="mUrl" class="mono" placeholder="rtsp://admin:pass@192.168.21.178:554/ch01">
            <span class="hint">Dấu '%' trần trong mật khẩu sẽ tự đổi thành %25</span></div>
          <div class="field"><label>Tên luồng</label>
            <input id="mName" placeholder="cam178" pattern="[A-Za-z0-9_.\-]+">
            <span class="hint">Chỉ chữ, số, _ . - · trùng tên là ghi đè luồng cũ</span></div>
          <div class="field"><label>Media</label>
            <div class="seg" id="mMedia" style="align-self:flex-start">
              <button data-media="" class="on">Video + âm thanh</button>
              <button data-media="video">Chỉ video</button>
            </div>
            <span class="hint">Chỉ video: bỏ track audio ngay ở nguồn RTSP</span></div>
        </div>
        <div class="m-col">
          <div class="preview" id="mPrev"><span class="msg" id="mPrevMsg">Chưa kiểm tra</span></div>
          <div class="card"><div class="card-h">Kết quả kiểm tra</div><div id="mRows"></div></div>
          <button class="btn" id="mTest" style="justify-content:center;padding:11px 0">Kiểm tra kết nối</button>
        </div>
      </div>
      <div class="m-foot">
        <span class="hint" id="mHint">Luồng mới hiện ngay trong lưới Live</span>
        <div class="grow"></div>
        <button class="btn-gh" id="mCancel">Hủy</button>
        <button class="btn-cy" id="mAdd" data-sheen style="padding:10px 18px">Thêm vào hệ thống</button>
      </div>
    </div>
  </div>

  <!-- ===== XAC NHAN (dung chung) ===== -->
  <div class="overlay" id="cfWrap" hidden>
    <div class="modal" style="width:min(420px,100%)">
      <div class="m-head">
        <span class="m-title" id="cfTitle">Xác nhận</span>
        <div class="grow"></div>
        <button class="m-x" id="cfX">✕</button>
      </div>
      <div style="padding:16px;display:flex;flex-direction:column;gap:7px">
        <span id="cfMsg" style="font:500 13px/1.5 var(--b);color:var(--fg2)"></span>
        <span id="cfSub" class="hint"></span>
      </div>
      <div class="m-foot">
        <div class="grow"></div>
        <button class="btn-gh" id="cfNo">Hủy</button>
        <button class="btn-cy" id="cfYes" data-sheen>Xóa</button>
      </div>
    </div>
  </div>

  <!-- ===== NAP THUAT TOAN CHO CAMERA ===== -->
  <div class="overlay" id="fpWrap" hidden>
    <div class="modal" style="width:min(720px,100%)">
      <div class="m-head">
        <div style="display:flex;flex-direction:column;gap:3px;min-width:0">
          <span class="m-title">Nạp thuật toán · <span id="fpCam">—</span></span>
          <span class="sub q">Chỉ hiện thuật toán box đã nạp sẵn</span>
        </div>
        <div class="grow"></div>
        <button class="m-x" id="fpX">✕</button>
      </div>

      <div class="fp-cap">
        <span class="fp-cap-k">CÔNG SUẤT CÒN</span>
        <span class="fp-cap-v" id="fpHr">—</span>
        <div class="fp-bar"><i id="fpBar"></i></div>
        <div class="grow"></div>
        <span class="hint" id="fpCnt">—</span>
      </div>

      <div class="fp-body nosb" id="fpGrid"></div>

      <div class="m-foot">
        <span class="hint" id="fpHint">Bỏ tích để xóa thuật toán khỏi camera này</span>
        <div class="grow"></div>
        <button class="btn-gh" id="fpNo">Hủy</button>
        <button class="btn-cy" id="fpSave" data-sheen>Nạp thuật toán</button>
      </div>
    </div>
  </div>

  <div id="toasts"></div>
</div>

<template id="t-tile">
  <div class="tile" data-rim>
    <span data-edge="top"></span><span data-edge="right"></span><span data-edge="bottom"></span><span data-edge="left"></span>
    <div class="lines"></div>
    <div class="scan"></div>
    <div class="t-top">
      <div class="t-id"><div class="t-name"></div><div class="t-code"></div></div>
      <span class="badge wait">…</span>
    </div>
    <div class="t-bot">
      <span class="t-meta">—</span><div class="grow"></div><span class="t-note"></span>
    </div>
  </div>
</template>

<script type="module" src="ui.js"></script>
