<title>UNV SmartBox</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">

<div id="app">
  <header>
    <div style="display:flex;align-items:center;gap:10px">
      <div class="logo">U</div>
      <div style="display:flex;flex-direction:column;gap:1px">
        <span class="brand">UNV SmartBox</span>
        <span class="brand-sub">RTSP · GO2RTC</span>
      </div>
    </div>
    <div class="chip"><span class="k">VỊ TRÍ</span><span class="v" id="site">C27</span><span style="color:var(--off);font-size:10px">▾</span></div>
    <div class="grow"></div>
    <div class="stat"><span class="dot" style="background:var(--ok);animation:omPulse 2s ease-in-out infinite"></span><span id="cOnline">—</span></div>
    <span id="clock">--:--:--</span>
    <div class="avatar">TT</div>
  </header>

  <div class="body">
    <nav>
      <button data-go="live" class="on"><span class="i">▦</span><span class="l">Live</span></button>
      <button data-go="log"><span class="i">◷</span><span class="l">Nhật ký</span></button>
      <button data-go="cfg"><span class="i">⚙</span><span class="l">Cấu hình</span></button>
    </nav>

    <main>
      <!-- ===== LIVE ===== -->
      <section class="view" id="v-live">
        <div class="bar">
          <span class="h1">Tất cả camera</span>
          <span class="sub" id="camCount">—</span>
          <div class="grow"></div>
          <div class="drop">
            <button class="btn" id="fBtn"><span class="k">LỌC</span><span id="fLabel">Tất cả</span><span style="color:var(--ghost);font-size:10px">▾</span></button>
            <div class="menu" id="fMenu" hidden></div>
          </div>
          <div class="vr"></div>
          <div class="seg" id="layout">
            <button data-cols="2">2×2</button>
            <button data-cols="3" class="on">3×3</button>
            <button data-cols="4">4×4</button>
          </div>
          <div class="vr"></div>
          <button class="btn-cy" id="addBtn"><span style="font:500 14px/1 var(--m)">+</span>Thêm camera RTSP</button>
        </div>
        <div class="scroll">
          <div id="grid"></div>
          <div class="pager" id="pager" hidden>
            <div></div>
            <div class="mid">
              <button class="btn" id="pgPrev">← Trước</button>
              <span id="pgNums" style="display:flex;gap:10px"></span>
              <button class="btn" id="pgNext">Sau →</button>
            </div>
            <span class="range" id="pgRange"></span>
          </div>
        </div>
      </section>

      <!-- ===== DETAIL ===== -->
      <section class="view" id="v-detail" hidden>
        <div class="bar" style="padding:11px 18px">
          <button class="btn" id="back">← Tất cả camera</button>
          <div style="display:flex;flex-direction:column;gap:2px;min-width:0">
            <span class="h1" id="dName">—</span>
            <span class="sub" id="dSrc">—</span>
          </div>
          <div class="grow"></div>
          <button class="btn" id="dSnap">Lưu ảnh</button>
          <button class="btn btn-del" id="dDel">Xoá camera</button>
          <button class="btn" id="dReload">Tải lại luồng</button>
        </div>
        <div class="split">
          <div class="stage-wrap">
            <div class="stage" id="stage">
              <div class="lines"></div>
              <div class="s-top">
                <span class="live" id="dLive"><span class="dot"></span>LIVE</span>
                <span class="qual" id="dQual">—</span>
              </div>
              <div class="s-bot">
                <button id="dPlay" title="Tạm dừng">⏸</button>
                <button id="dMute" title="Bật tiếng">🔇</button>
                <button id="dFull" title="Toàn màn hình">⛶</button>
                <div class="grow"></div>
                <span class="qual" id="dUp">—</span>
              </div>
            </div>
          </div>
          <aside>
            <div class="card">
              <div class="card-h">LUỒNG RTSP</div>
              <div id="dRows"></div>
            </div>
            <div class="card">
              <div class="card-h">PHIÊN XEM</div>
              <div id="dRows2"></div>
            </div>
          </aside>
        </div>
      </section>

      <!-- ===== LOG ===== -->
      <section class="view" id="v-log" hidden>
        <div class="bar">
          <span class="h1">Nhật ký go2rtc</span>
          <span class="sub">GET /api/log · bộ đệm trong RAM</span>
          <div class="grow"></div>
          <label style="display:flex;align-items:center;gap:7px;cursor:pointer;color:var(--dim)">
            <input type="checkbox" id="logAuto" checked style="width:auto;padding:0;accent-color:var(--cy)">Tự làm mới
          </label>
          <button class="btn" id="logRefresh">Làm mới</button>
          <button class="btn" id="logClear">Xoá bộ đệm</button>
        </div>
        <div class="scroll"><div class="log" id="logBox"></div></div>
      </section>

      <!-- ===== CONFIG ===== -->
      <section class="view" id="v-cfg" hidden>
        <div class="bar">
          <span class="h1">Cấu hình go2rtc</span>
          <span class="sub" id="cfgPath">GET /api/config</span>
          <div class="grow"></div>
          <button class="btn" id="cfgRefresh">Làm mới</button>
        </div>
        <div class="scroll">
          <div class="card"><pre class="yaml" id="cfgBox">…</pre></div>
          <div class="hint" style="padding:10px 2px">Chỉ đọc · mật khẩu đã được ẩn. Sửa file go2rtc.yaml rồi khởi động lại go2rtc để áp dụng.</div>
        </div>
      </section>
    </main>
  </div>

  <!-- ===== ADD MODAL ===== -->
  <div class="overlay" id="modal" hidden>
    <div class="modal">
      <div class="m-head">
        <div style="display:flex;flex-direction:column;gap:3px">
          <span class="m-title">Thêm camera qua RTSP</span>
          <span class="sub">PUT /api/streams · ghi thẳng vào go2rtc.yaml</span>
        </div>
        <div class="grow"></div>
        <button class="m-x" id="mClose">✕</button>
      </div>
      <div class="m-body">
        <div class="m-col">
          <div class="field">
            <label>URL RTSP</label>
            <input id="mUrl" class="mono" placeholder="rtsp://admin:pass@192.168.21.178:554/ch01">
            <span class="hint">Dấu '%' trần trong mật khẩu sẽ tự đổi thành %25</span>
          </div>
          <div class="field">
            <label>TÊN LUỒNG</label>
            <input id="mName" placeholder="cam178" pattern="[A-Za-z0-9_.\-]+">
            <span class="hint">Chỉ chữ, số, _ . - · trùng tên là ghi đè luồng cũ</span>
          </div>
          <div class="field">
            <label>MEDIA</label>
            <div class="seg" id="mMedia" style="align-self:flex-start">
              <button data-media="" class="on">Video + âm thanh</button>
              <button data-media="video">Chỉ video</button>
            </div>
            <span class="hint">Chỉ video: bỏ track audio ngay ở nguồn RTSP</span>
          </div>
        </div>
        <div class="m-col">
          <div class="preview" id="mPrev"><span class="msg" id="mPrevMsg">Chưa kiểm tra · bấm "Kiểm tra kết nối"</span></div>
          <div class="test-card">
            <div class="card-h">KẾT QUẢ KIỂM TRA</div>
            <div id="mRows"></div>
          </div>
          <button class="btn" id="mTest" style="justify-content:center;padding:11px 0">Kiểm tra kết nối</button>
        </div>
      </div>
      <div class="m-foot">
        <span class="hint" id="mHint">Luồng mới hiện ngay trong lưới Live</span>
        <div class="grow"></div>
        <button class="btn-gh" id="mCancel">Hủy</button>
        <button class="btn-cy" id="mAdd" style="padding:10px 18px">Thêm vào hệ thống</button>
      </div>
    </div>
  </div>

  <div id="toasts"></div>
</div>

<template id="t-tile">
  <div class="tile">
    <div class="lines"></div>
    <div class="scan"></div>
    <div class="t-top">
      <div class="t-id">
        <div class="t-name"></div>
        <div class="t-code"></div>
      </div>
      <span class="badge wait">…</span>
    </div>
    <div class="t-bot">
      <span class="t-meta">—</span>
      <div class="grow"></div>
      <span class="t-note"></span>
    </div>
  </div>
</template>

<script type="module" src="ui.js"></script>
